<%- include('partials/header') %>
<!-- Hero Image Banner -->
    <header class="relative w-full h-[50vh] min-h-[400px] pt-20 flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0 bg-[url('/static/hero_images/dark_worship.jpg')] bg-cover bg-center"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-white/80 via-white/70 to-[#FAFAFA] dark:from-[#0b1437]/90 dark:via-[#0b1437]/80 dark:to-[#0b1437]"></div>
        
        <div class="relative z-10 text-center px-6">
            <h1 class="text-5xl md:text-7xl font-extrabold text-gray-900 dark:text-white mb-4 tracking-tight drop-shadow-lg">
                <%= typeof t !== 'undefined' ? t('membership.heroTitle') : 'Plant Your Roots.' %>
            </h1>
            <p class="text-xl md:text-2xl text-gray-700 dark:text-gray-300 font-medium max-w-2xl mx-auto drop-shadow-md">
                <%= typeof t !== 'undefined' ? t('membership.heroSubtitle') : 'Commit to a local body and be known.' %>
            </p>
        </div>
    </header>

    <!-- Main Content Overlapping Hero -->
    <main class="flex-1 max-w-4xl mx-auto w-full px-6 py-8 -mt-16 relative z-20 macos-glass mb-12">
        
        <div class="flex items-center gap-2 mb-4">
            <span class="bg-gray-100 dark:bg-white/10 text-gray-600 dark:text-gray-300 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <%= typeof t !== 'undefined' ? t('common.readTime', { min: '4' }) : '4 MIN READ' %>
            </span>
        </div>
        <div class="flex items-center justify-between mb-8 border-b border-gray-200 dark:border-white/10 pb-6">
            <h2 class="text-3xl font-black text-gray-900 dark:text-white tracking-tight">
                <%= typeof t !== 'undefined' ? t('membership.title') : 'Membership' %>
            </h2>
            <div class="w-24 h-1 rounded-full opacity-80" style="background-color: #ec4899"></div>
        </div>
        
        <div class="prose max-w-none">
            <div class="mb-8">
                <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white flex items-center gap-3">
                    <svg class="w-6 h-6 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <%= typeof t !== 'undefined' ? t('membership.section1.title') : 'Why Membership Matters' %>
                </h3>
                <div class="p-6 bg-gray-50 hover:bg-gray-100 dark:hover:bg-white/10 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg dark:bg-white/5 rounded-2xl border-l-4 my-6" style="border-color: currentColor">
                    <p class="text-gray-800 dark:text-gray-200 text-lg font-medium leading-relaxed italic">
                        <%= typeof t !== 'undefined' ? t('membership.section1.q1') : 'The New Testament doesn\'t know anything about isolated, free-agent Christians. When Paul wrote his letters, he wrote them to churches — specific, named, local communities of believers who were committed to one another (1 Corinthians 12:12-27).' %>
                    </p>
                </div>
                <p class="text-gray-600 dark:text-gray-400 text-lg leading-relaxed mb-4">
                    <%= typeof t !== 'undefined' ? t('membership.section1.p1') : 'Membership is not a country club card — it is you saying, "I am choosing to be known here. I am choosing to be accountable here. I am planting my life in this soil and letting my roots go deep."' %>
                </p>
            </div>

            <div class="mb-8">
                <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white flex items-center gap-3">
                    <svg class="w-6 h-6 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <%= typeof t !== 'undefined' ? t('membership.section2.title') : 'What We Believe' %>
                </h3>
                <div class="p-6 bg-gray-50 hover:bg-gray-100 dark:hover:bg-white/10 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg dark:bg-white/5 rounded-2xl border-l-4 my-6" style="border-color: currentColor">
                    <p class="text-gray-800 dark:text-gray-200 text-lg font-medium leading-relaxed italic">
                        <%= typeof t !== 'undefined' ? t('membership.section2.q1') : 'We believe the Bible is the inspired, authoritative Word of God. We believe in one God eternally existent in three persons: Father, Son, and Holy Spirit. We believe in salvation by grace through faith in Jesus Christ alone.' %>
                    </p>
                </div>
            </div>

            <div class="mb-8">
                <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white flex items-center gap-3">
                    <svg class="w-6 h-6 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <%= typeof t !== 'undefined' ? t('membership.section3.title') : 'The Membership Covenant' %>
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-lg leading-relaxed mb-4">
                    <%= typeof t !== 'undefined' ? t('membership.section3.p1') : 'Membership is a two-way covenant. As a member, you commit to gather consistently, serve with your spiritual gifts, give generously, pursue holiness, and live in authentic community.' %>
                </p>
            </div>
        </div>
        
        <div class="mt-16 pt-8 border-t border-gray-200 dark:border-white/10">
            <a href="/#join" class="block w-full text-center text-white font-bold text-lg py-5 rounded-xl hover:opacity-90 transition-all shadow-lg transform hover:-translate-y-1" style="background-color: #ec4899">
                <%= typeof t !== 'undefined' ? t('membership.ctaBtn') : 'Apply for Membership' %>
            </a>
        </div>
    </main>

    <!-- Join Us Section -->
    <%- include('partials/join-section') %>
<%- include('partials/footer') %>
