<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EUCMD Young Adults - Redesign V2</title>

    <!-- Requested Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS (via existing script) -->
    <script src="/static/js/vendor/tailwindcss.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Montserrat', 'sans-serif'],
                    },
                    colors: {
                        glass: {
                            light: 'rgba(255, 255, 255, 0.7)',
                            border: 'rgba(255, 255, 255, 0.4)',
                        },
                        navy: {
                            900: '#0B1120',
                            800: '#141E33',
                        },
                        slate: {
                            900: '#0F172A',
                            800: '#1E293B',
                        }
                    }
                }
            }
        }
    </script>
    
    <!-- Production Ready CSS for Glassmorphism & Background -->
    <link rel="stylesheet" href="/static/css/glassmorphism-redesign.css">

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-navy-900 text-slate-900 antialiased font-sans relative">
    
    <!-- Abstract Flowing Background -->
    <div class="flowing-bg"></div>

    <!-- Navigation (Glass) -->
    <nav class="fixed w-full z-50 px-6 py-4">
        <div class="max-w-7xl mx-auto glass-panel px-6 py-3 flex justify-between items-center rounded-full">
            <span class="font-heading font-bold tracking-tight text-white">EUCMD YA</span>
            <div class="hidden md:flex gap-6 text-white">
                <a href="#resources" class="text-sm font-semibold hover:opacity-70 transition-opacity">Resources</a>
                <a href="#next-steps" class="text-sm font-semibold hover:opacity-70 transition-opacity">Next Steps</a>
                <a href="#prayer" class="text-sm font-semibold hover:opacity-70 transition-opacity">Prayer</a>
            </div>
        </div>
    </nav>

    <main class="relative z-10">
        
        <!-- Hero Section -->
        <section class="min-h-screen flex items-center justify-center px-6 pt-32 pb-24">
            <div class="max-w-3xl w-full glass-panel p-10 md:p-16 text-center shadow-2xl">
                <div class="inline-flex items-center justify-center mb-6 tag-pill">
                    Foundation
                </div>
                <h1 class="font-heading font-black text-5xl md:text-7xl tracking-tight text-white mb-6 leading-[1.1]">
                    Growing Deep.<br/>Reaching Wide.
                </h1>
                <p class="text-lg text-slate-200 mb-10 max-w-xl mx-auto leading-relaxed">
                    A vibrant community of young adults seeking to build a resilient faith, discover purpose, and impact the world.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="#next-steps" class="bg-white text-navy-900 font-semibold px-8 py-4 rounded-full hover:bg-slate-200 transition-colors shadow-xl">
                        Find Community
                    </a>
                    <a href="#prayer" class="bg-white/10 text-white font-semibold px-8 py-4 rounded-full border border-white/20 hover:bg-white/20 transition-colors">
                        Request Prayer
                    </a>
                </div>
            </div>
        </section>

        <!-- Your Next Steps Section -->
        <section id="next-steps" class="py-24 px-6">
            <div class="max-w-7xl mx-auto">
                <div class="text-center mb-16">
                    <div class="inline-flex items-center justify-center mb-4 tag-pill">
                        Belong
                    </div>
                    <h2 class="font-heading font-black text-4xl md:text-5xl text-white drop-shadow-lg">Your Next Steps</h2>
                </div>
                
                <div class="grid md:grid-cols-3 gap-8">
                    <!-- Card 1 -->
                    <div class="glass-panel p-8 hover:-translate-y-2 transition-transform duration-300">
                        <i data-lucide="users" class="w-8 h-8 mb-6 text-white/80"></i>
                        <h3 class="font-heading font-bold text-2xl mb-3 text-white">Attend a Gathering</h3>
                        <p class="text-slate-200 leading-relaxed">
                            Join us every Friday night for worship, teaching, and genuine connection. Come as you are.
                        </p>
                    </div>
                    <!-- Card 2 -->
                    <div class="glass-panel p-8 hover:-translate-y-2 transition-transform duration-300">
                        <i data-lucide="compass" class="w-8 h-8 mb-6 text-white/80"></i>
                        <h3 class="font-heading font-bold text-2xl mb-3 text-white">Find Community</h3>
                        <p class="text-slate-200 leading-relaxed">
                            Join a small group to dive deeper into the Word and share life with peers navigating the same season.
                        </p>
                    </div>
                    <!-- Card 3 -->
                    <div class="glass-panel p-8 hover:-translate-y-2 transition-transform duration-300">
                        <i data-lucide="heart-handshake" class="w-8 h-8 mb-6 text-white/80"></i>
                        <h3 class="font-heading font-bold text-2xl mb-3 text-white">Make an Impact</h3>
                        <p class="text-slate-200 leading-relaxed">
                            Discover your gifts and serve our city. There's a place for you to lead and contribute here.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Discipleship Resources (Clean Background as requested) -->
        <section id="resources" class="py-24 px-6 bg-slate-50 text-slate-900">
            <div class="max-w-5xl mx-auto">
                <div class="mb-12">
                    <div class="inline-flex items-center justify-center mb-4 tag-pill border-slate-300 text-slate-700">
                        Formation
                    </div>
                    <h2 class="font-heading font-black text-4xl text-slate-900">Discipleship Resources</h2>
                    <p class="text-slate-600 mt-4 text-lg max-w-2xl">Readings, guides, and tools designed for high legibility to help you grow deep in your walk.</p>
                </div>
                
                <div class="bg-white rounded-[24px] shadow-sm border border-slate-200 p-8 md:p-12">
                    <div class="flex items-center justify-between border-b border-slate-100 py-4">
                        <div>
                            <h4 class="font-bold text-xl mb-1">Bible Reading Plan</h4>
                            <p class="text-slate-500">Chronological plan for 2026</p>
                        </div>
                        <a href="#" class="text-slate-900 font-medium hover:underline">Download</a>
                    </div>
                    <div class="flex items-center justify-between border-b border-slate-100 py-4">
                        <div>
                            <h4 class="font-bold text-xl mb-1">How to Pray</h4>
                            <p class="text-slate-500">A guide to the Lord's Prayer</p>
                        </div>
                        <a href="#" class="text-slate-900 font-medium hover:underline">Read Article</a>
                    </div>
                    <div class="flex items-center justify-between py-4">
                        <div>
                            <h4 class="font-bold text-xl mb-1">Fasting 101</h4>
                            <p class="text-slate-500">Spiritual disciplines for the modern believer</p>
                        </div>
                        <a href="#" class="text-slate-900 font-medium hover:underline">Listen</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- YouTube & Testimonials Section -->
        <section class="py-24 px-6">
            <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
                
                <!-- YouTube Embed -->
                <div class="glass-panel p-4 md:p-6 shadow-2xl">
                    <div class="aspect-video bg-slate-900 rounded-2xl overflow-hidden relative">
                        <!-- Placeholder for YouTube -->
                        <div class="absolute inset-0 flex flex-col items-center justify-center text-white/50">
                            <i data-lucide="play-circle" class="w-16 h-16 mb-2"></i>
                            <span>Latest Teaching</span>
                        </div>
                    </div>
                </div>

                <!-- Testimonial -->
                <div class="glass-panel p-10 shadow-xl">
                    <div class="inline-flex items-center justify-center mb-6 tag-pill">
                        Life Change
                    </div>
                    <h2 class="font-heading font-black text-3xl md:text-4xl text-white mb-6">"I finally found a place where I belong."</h2>
                    <p class="text-lg text-slate-200 italic mb-8">
                        "Before coming to EUCMD Young Adults, I was struggling to find my identity and purpose. The community here embraced me, and the teachings challenged me to go deeper. It's truly a place of transformation."
                    </p>
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-slate-200"></div>
                        <div>
                            <p class="font-bold text-white">Sarah Jenkins</p>
                            <p class="text-sm text-slate-300">Joined in 2024</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Forms Section -->
        <section id="prayer" class="py-24 px-6">
            <div class="max-w-2xl mx-auto glass-panel p-10 md:p-14 shadow-2xl">
                <div class="text-center mb-10">
                    <div class="inline-flex items-center justify-center mb-4 tag-pill">
                        Mission
                    </div>
                    <h2 class="font-heading font-black text-4xl text-white">How can we pray for you?</h2>
                    <p class="text-slate-200 mt-2">Our team would love to stand in faith with you.</p>
                </div>

                <form class="space-y-6">
                    <div>
                        <label class="block text-sm font-semibold text-slate-100 mb-2">Name (Optional)</label>
                        <input type="text" class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-white focus:bg-white/20 transition-colors" placeholder="Your name">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-100 mb-2">Prayer Request</label>
                        <textarea rows="4" class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-white focus:bg-white/20 transition-colors resize-none" placeholder="Share what's on your heart..."></textarea>
                    </div>
                    <button type="submit" class="w-full bg-white text-navy-900 font-bold py-4 rounded-xl hover:bg-slate-200 transition-colors shadow-lg">
                        Submit Request
                    </button>
                </form>
            </div>
        </section>
        
    </main>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>
