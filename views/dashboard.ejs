<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="description" content="Dashboard and leader tools for EUCMD Young Adults.">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https:;">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <title>EUC Dashboard</title>
    <script src="/static/js/vendor/tailwindcss.js"></script>
    <script src="/static/js/vendor/vue.global.js"></script>
    <script src="/static/js/vendor/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Montserrat', 'sans-serif'],
                    },
                    colors: {
                        navy: {
                            900: '#0B1120',
                            800: '#141E33',
                        },
                        slate: {
                            900: '#0F172A',
                            800: '#1E293B',
                        },
                        accent: '#3b82f6',
                        success: '#10b981',
                        brandDark: '#0B1120',
                        cardDark: 'rgba(255, 255, 255, 0.12)',
                        borderDark: 'rgba(255, 255, 255, 0.3)'
                    }
                }
            }
        }
                }
            }
        }
    </script>
    <script>
        window.USER_PERMISSIONS = <%- JSON.stringify(user_permissions || []) %>;
        window.USER_EMAIL = "<%- user_email || "" %>";
        window.USER_ROLE = "<%- user_role || "" %>";
    </script>
<style>
        [v-cloak] { display: none; }
        html { scroll-behavior: smooth; }
        
        body { 
            font-family: 'Inter', sans-serif; 
            -webkit-font-smoothing: antialiased; 
            background: #0b1120; 
            color: #f1f0ea; 
        }

        /* Abstract Flowing Background */
        .flowing-bg {
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            z-index: -1;
            background-color: #0b1120;
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(30, 45, 80, 0.9) 0%, transparent 45%),
                radial-gradient(circle at 85% 30%, rgba(60, 45, 20, 0.5) 0%, transparent 45%),
                radial-gradient(circle at 50% 80%, rgba(30, 41, 59, 0.7) 0%, transparent 50%);
            pointer-events: none;
        }

        .glass, .stat-card, .kanban-card { 
            position: relative;
            background-color: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(20px) saturate(150%);
            -webkit-backdrop-filter: blur(20px) saturate(150%);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 1.5rem;
            box-shadow: 
                0 20px 40px -10px rgba(0, 0, 0, 0.4),
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
            color: #f1f0ea;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            overflow: hidden;
        }
        
        .glass-dark { background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); }
        .glass-input { 
            background: rgba(255, 255, 255, 0.1); 
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.2); 
            border-radius: 0.75rem;
            outline: none; 
            backdrop-filter: blur(10px);
        }
        .glass-input:focus { border-color: rgba(255,255,255,0.5); box-shadow: 0 0 15px rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.15); }
        .sidebar-bg { 
            background-color: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(30px);
            border-right: 1px solid rgba(255,255,255,0.1);
        }
        .stat-card:hover, .kanban-card:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -15px rgba(0,0,0,0.5); }
        .accent { color: #f1f0ea; }
        .bg-accent { background-color: rgba(255,255,255,0.2); box-shadow: 0 0 15px rgba(255, 255, 255, 0.1); border: 1px solid rgba(255,255,255,0.3); }
        
        h1, h2, h3, h4, h5, h6, .font-heading { font-family: 'Montserrat', sans-serif; }

        /* Pulse Animation for Loading */
        .animate-pulse-slow { animation: pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
    </style>
</head>
<body class="bg-brandDark text-white font-sans">
<div class="flowing-bg"></div>

<div id="app" v-cloak class="min-h-screen flex text-slate-200">
    
    <!-- Mobile Overlay -->
    <div v-if="isSidebarOpen" @click="isSidebarOpen = false" class="fixed inset-0 bg-brandDark/80 z-[45] md:hidden backdrop-blur-sm transition-opacity"></div>
    
    <!-- Sidebar -->
    <aside class="w-72 bg-cardDark md:bg-transparent backdrop-blur-2xl h-[100dvh] fixed left-0 top-0 text-white flex flex-col z-50 transition-transform duration-300" :class="isSidebarOpen ? 'translate-x-0 shadow-2xl' : '-translate-x-full md:translate-x-0'">
        <div class="p-6">
            <div class="flex items-center gap-3 mb-2">
                <img src="/static/euc_logo.jpg" alt="EUC Logo" class="h-12 w-12 rounded-full object-cover shadow-sm border border-white/10">
                <div>
                    <h1 class="text-2xl font-black tracking-tight text-white leading-none">EUC<span class="text-accent text-sm">.</span></h1>
                    <p class="text-white/60 text-[10px] uppercase tracking-widest font-semibold mt-1">Dashboard</p>
                </div>
            </div>
        </div>
        
        <div class="w-full h-px border-t border-white/10 mb-6"></div>
        
        <nav class="flex-1 px-4 space-y-2 overflow-y-auto">
            <button v-for="nav in navItems" :key="nav.id" @click="currentView = nav.id"
                class="w-full text-left py-3.5 px-4 rounded-xl text-sm font-semibold transition-all flex items-center gap-4 relative overflow-hidden"
                :class="currentView === nav.id ? 'glass shadow-sm border border-white/20 text-white' : 'text-slate-300 hover:text-white hover:bg-white/10'">
                <!-- Icon box -->
                <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 transition-colors"
                     :class="currentView === nav.id ? 'bg-white/20 text-white' : 'bg-cardDark text-accent border border-white/10 shadow-sm'">
                    <span v-html="nav.icon" class="w-4 h-4 flex items-center justify-center"></span>
                </div>
                {{ nav.label }}
            </button>
        </nav>
        
        <div class="p-6 mt-auto">
            <a href="/" class="text-white/60 hover:text-white/60 text-sm flex items-center gap-2 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Back to Website
            </a>
        </div>
        <div class="p-4 mt-auto" style="padding-bottom: calc(1rem + env(safe-area-inset-bottom));">
            <a href="/logout" class="w-full text-left py-3.5 px-4 rounded-xl text-sm font-semibold transition-all flex items-center gap-4 text-red-400 hover:text-red-300 hover:bg-red-500/10">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 bg-red-500/10 text-red-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                </div>
                Logout
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="md:ml-72 flex-1 min-h-screen p-4 md:p-8 pt-24 md:pt-8 w-full overflow-x-hidden">
        
        <!-- Header -->
        <header class="flex justify-between items-center mb-8 fixed md:static top-0 left-0 right-0 p-4 md:p-0 bg-brandDark/90 md:bg-transparent backdrop-blur-md z-40 border-b border-white/10 md:border-transparent">
            <div class="flex items-center gap-3">
                <button aria-label="Toggle mobile menu" @click="isSidebarOpen = !isSidebarOpen" class="md:hidden w-11 h-11 rounded-xl glass flex items-center justify-center text-slate-300 hover:text-white relative z-50">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <h2 class="text-2xl font-bold text-white">{{ currentViewTitle }}</h2>
            </div>
            
            <!-- Top YA Menu -->
            <div class="hidden lg:flex items-center gap-6 absolute left-1/2 -translate-x-1/2">
                <button @click="currentView = 'ya_hub'" class="text-sm font-bold transition-colors" :class="currentView === 'ya_hub' ? 'text-blue-500' : 'text-slate-300 hover:text-white'">YA Hub</button>
                <button @click="currentView = 'ya_groups'" class="text-sm font-bold transition-colors" :class="currentView === 'ya_groups' ? 'text-blue-500' : 'text-slate-300 hover:text-white'">Groups</button>
                <button @click="currentView = 'ya_toolkit'" class="text-sm font-bold transition-colors" :class="currentView === 'ya_toolkit' ? 'text-blue-500' : 'text-slate-300 hover:text-white'">Toolkit</button>
                <button @click="currentView = 'ya_reflections'" class="text-sm font-bold transition-colors" :class="currentView === 'ya_reflections' ? 'text-blue-500' : 'text-slate-300 hover:text-white'">Reflections</button>
            </div>
            <div class="flex items-center gap-4">
                <div class="relative">
                    <button @click="showNotifications = !showNotifications" class="w-10 h-10 rounded-full glass flex items-center justify-center text-slate-300 hover:text-white  transition-colors relative">
                        🔔
                        <span v-if="notifications.length > 0" class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full shadow-sm"></span>
                    </button>
                    <!-- Notification Dropdown -->
                    <div v-show="showNotifications" class="absolute right-0 mt-2 w-72 glass bg-brandDark rounded-2xl shadow-[0_10px_40px_rgba(0,0,0,0.5)] border border-white/10 overflow-hidden z-50">
                        <div class="px-4 py-3 border-b border-white/10 bg-white/5">
                            <h3 class="font-bold text-white">Notifications ({{ notifications.length }})</h3>
                        </div>
                        <div class="max-h-64 overflow-y-auto">
                            <div v-if="notifications.length === 0" class="p-4 text-center text-slate-300 text-sm">
                                No new notifications
                            </div>
                            <button v-for="notif in notifications" :key="notif.id" @click="handleNotificationClick(notif)" class="w-full text-left p-4 border-b border-white/10 hover:bg-white/10 transition-colors flex items-start gap-3">
                                <div class="w-8 h-8 rounded-full bg-accent/20 flex flex-shrink-0 items-center justify-center text-accent">
                                    <span v-html="notif.icon"></span>
                                </div>
                                <div>
                                    <p class="text-white text-sm font-semibold">{{ notif.title }}</p>
                                    <p class="text-slate-300 text-xs mt-1">{{ notif.message }}</p>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Loading State -->
        <div v-if="loading" class="w-full h-64 glass rounded-2xl flex items-center justify-center animate-pulse-slow">
            <div class="flex flex-col items-center gap-4 text-slate-300">
                <svg class="w-8 h-8 animate-spin text-accent" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <p>Loading data...</p>
            </div>
        </div>

        <!-- 1. OVERVIEW -->
        <div v-show="currentView === 'overview' && !loading" class="space-y-6 pb-12"><style>
                @keyframes float {
                    0% { transform: translateY(0px); }
                    50% { transform: translateY(-10px); }
                    100% { transform: translateY(0px); }
                }
                @keyframes pulse-glow {
                    0% { box-shadow: 0 0 0 0 rgba(0, 117, 255, 0.7); }
                    70% { box-shadow: 0 0 0 15px rgba(0, 117, 255, 0); }
                    100% { box-shadow: 0 0 0 0 rgba(0, 117, 255, 0); }
                }
                @keyframes slideRight {
                    from { width: 0%; }
                    to { width: var(--target-width); }
                }
                @keyframes fadeUp {
                    from { opacity: 0; transform: translateY(20px); }
                    to { opacity: 1; transform: translateY(0); }
                }
                .anim-float { animation: float 6s ease-in-out infinite; }
                . { animation: pulse-glow 2s infinite; }
                .anim-bar { animation: slideRight 1.5s cubic-bezier(0.1, 0.8, 0.2, 1) forwards; }
                .stagger-1 { animation: fadeUp 0.6s ease-out forwards; animation-delay: 0.1s; opacity: 0; }
                .stagger-2 { animation: fadeUp 0.6s ease-out forwards; animation-delay: 0.2s; opacity: 0; }
                .stagger-3 { animation: fadeUp 0.6s ease-out forwards; animation-delay: 0.3s; opacity: 0; }
                .stagger-4 { animation: fadeUp 0.6s ease-out forwards; animation-delay: 0.4s; opacity: 0; }
                
                .glass-card-anim {
                    background: linear-gradient(145deg, rgba(17, 28, 68, 0.8) 0%, rgba(11, 20, 55, 0.9) 100%);
                    border: 1px solid rgba(255, 255, 255, 0.05);
                    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
                    position: relative;
                    overflow: hidden;
                    transition: all 0.3s ease;
                }
                .glass-card-anim:hover {
                    transform: translateY(-5px);
                    border-color: rgba(0, 117, 255, 0.3);
                    box-shadow: 0 15px 40px rgba(0, 117, 255, 0.15);
                }
                .glass-card-anim::before {
                    content: '';
                    position: absolute;
                    top: 0; left: 0; right: 0; height: 1px;
                    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
                }
            </style>

            <!-- Hero Welcome -->
            <div class="glass-card-anim rounded-3xl p-8 flex flex-col md:flex-row justify-between items-center stagger-1 overflow-visible">
                <div class="z-10 relative">
                    <p class="text-accent font-bold tracking-widest uppercase text-sm mb-2">Live Command Center</p>
                    <h2 class="text-4xl md:text-5xl font-extrabold text-white mb-4">Ministry <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-success">Pulse</span></h2>
                    <p class="text-slate-300 max-w-lg leading-relaxed">
                        Real-time analytics across all ministry departments. Watch your community grow, track prayer requests, and monitor discipleship journeys dynamically.
                    </p>
                </div>
                <div class="relative w-48 h-48 mt-8 md:mt-0 flex-shrink-0 anim-float">
                    <div class="absolute inset-0 bg-accent/20 rounded-full blur-3xl"></div>
                    <svg class="w-full h-full relative z-10 text-white opacity-90 drop-shadow-sm" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                
                <!-- MEMBERS & PODS (Combined Health) -->
                <div class="glass-card-anim rounded-3xl p-6 stagger-2" @click="currentView = 'members'">
                    <div class="flex justify-between items-start mb-6">
                        <div>
                            <h3 class="text-xl font-bold text-white mb-1">Community Health</h3>
                            <p class="text-xs text-slate-300">Members & DNA Pods</p>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-accent/20 text-accent flex items-center justify-center font-bold shadow-sm">👥</div>
                    </div>
                    
                    <div class="flex items-end gap-3 mb-6">
                        <span class="text-4xl font-extrabold text-white">{{ (allMembers || []).length }}</span>
                        <span class="text-sm text-slate-300 mb-1">Total Members</span>
                    </div>
                    
                    <div class="space-y-4">
                        <div>
                            <div class="flex justify-between text-xs font-bold text-slate-300 mb-1 uppercase tracking-wider">
                                <span>Pod Integration</span>
                                <span class="text-accent">{{ Math.round(((allMembers || []).filter(m => (pods || []).some(p => (p.members || []).some(pm => pm.id === m.id))).length / ((allMembers || []).length || 1)) * 100) }}%</span>
                            </div>
                            <div class="h-2 bg-brandDark rounded-full overflow-hidden border border-white/10">
                                <div class="h-full bg-gradient-to-r from-accent to-blue-400 rounded-full anim-bar" :style="`--target-width: ${Math.round(((allMembers || []).filter(m => (pods || []).some(p => (p.members || []).some(pm => pm.id === m.id))).length / ((allMembers || []).length || 1)) * 100)}%`"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs font-bold text-slate-300 mb-1 uppercase tracking-wider">
                                <span>Active Status</span>
                                <span class="text-success">{{ Math.round(((allMembers || []).filter(m => m.is_active).length / ((allMembers || []).length || 1)) * 100) }}%</span>
                            </div>
                            <div class="h-2 bg-brandDark rounded-full overflow-hidden border border-white/10">
                                <div class="h-full bg-gradient-to-r from-success to-emerald-400 rounded-full anim-bar" :style="`--target-width: ${Math.round(((allMembers || []).filter(m => m.is_active).length / ((allMembers || []).length || 1)) * 100)}%`"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PIPELINE & JOURNEY -->
                <div class="glass-card-anim rounded-3xl p-6 stagger-3" @click="currentView = 'pipeline'">
                    <div class="flex justify-between items-start mb-6">
                        <div>
                            <h3 class="text-xl font-bold text-white mb-1">Onboarding Flow</h3>
                            <p class="text-xs text-slate-300">Pipeline & Journey</p>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-success/20 text-success flex items-center justify-center font-bold shadow-sm">🔄</div>
                    </div>
                    
                    <div class="relative h-32 flex items-center justify-between px-2">
                        <!-- Connecting Line -->
                        <div class="absolute left-6 right-6 h-0.5 bg-brandDark top-1/2 -translate-y-1/2 z-0">
                            <div class="h-full bg-gradient-to-r from-white/20 to-success/50 w-full anim-bar" style="--target-width: 100%;"></div>
                        </div>
                        
                        <!-- Pipeline Stages -->
                        <div v-for="(col, index) in pipelineCols.slice(0,3)" :key="index" class="relative z-10 flex flex-col items-center">
                            <div class="w-12 h-12 rounded-full border-2 bg-cardDark flex items-center justify-center font-bold shadow-lg transition-transform hover:scale-110" 
                                 :class="col.items.length > 0 ? 'border-success text-success ' : 'border-white/10 text-slate-300'">
                                {{ col.items.length }}
                            </div>
                            <p class="text-[9px] font-bold uppercase tracking-wider mt-2 text-center w-16 text-slate-300 leading-tight">{{ col.title.split(' ')[0] }}</p>
                        </div>
                    </div>
                    <div class="mt-2 text-center text-xs text-slate-300 italic">Click to view full Kanban board</div>
                </div>

                <!-- PRAYER WALL -->
                <div class="glass-card-anim rounded-3xl p-6 stagger-4" @click="currentView = 'prayer'">
                    <div class="flex justify-between items-start mb-6">
                        <div>
                            <h3 class="text-xl font-bold text-white mb-1">Spiritual Warfare</h3>
                            <p class="text-xs text-slate-300">Prayer Wall Activity</p>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-amber-500/20 text-amber-500 flex items-center justify-center font-bold shadow-sm ">🙏</div>
                    </div>
                    
                    <div class="flex gap-4">
                        <div class="flex-1 bg-white/5 rounded-2xl p-4 border border-white/10 text-center relative overflow-hidden">
                            <div class="absolute top-0 right-0 w-16 h-16 bg-red-500/10 rounded-full blur-xl"></div>
                            <p class="text-3xl font-extrabold text-white mb-1">{{ prayers.active ? prayers.active.length : 0 }}</p>
                            <p class="text-[10px] font-bold text-slate-300 uppercase tracking-widest">Active Requests</p>
                        </div>
                        <div class="flex-1 bg-white/5 rounded-2xl p-4 border border-white/10 text-center relative overflow-hidden">
                            <div class="absolute top-0 right-0 w-16 h-16 bg-success/10 rounded-full blur-xl"></div>
                            <p class="text-3xl font-extrabold text-white mb-1">{{ prayers.answered ? prayers.answered.length : 0 }}</p>
                            <p class="text-[10px] font-bold text-slate-300 uppercase tracking-widest">Answered</p>
                        </div>
                    </div>
                    
                    <div v-if="prayers.active && prayers.active.length > 0" class="mt-4 p-3 bg-red-500/10 border border-red-500/20 rounded-xl flex items-center gap-3">
                        <span class="relative flex h-3 w-3 flex-shrink-0">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
                        </span>
                        <p class="text-xs font-medium text-red-300 truncate">Latest: {{ prayers.active[0].text }}</p>
                    </div>
                </div>
            </div>

            <!-- Bottom Row -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- RESOURCES & TRAINING -->
                <div class="glass-card-anim rounded-3xl p-6 flex flex-col justify-center stagger-3" style="animation-delay: 0.5s;">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-12 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center font-bold shadow-sm">📚</div>
                        <div>
                            <h3 class="text-xl font-bold text-white mb-1">Knowledge Base</h3>
                            <p class="text-xs text-slate-300">Training & Resources</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <button @click="currentView = 'training'" class="bg-brandDark hover:bg-white/10 border border-white/10 rounded-2xl p-4 text-left transition-colors group">
                            <span class="text-2xl mb-2 block group-hover:scale-110 transition-transform origin-left">🎓</span>
                            <span class="font-bold text-sm text-white block">Training Guide</span>
                            <span class="text-[10px] text-slate-300 block mt-1">CUC Leadership Framework</span>
                        </button>
                        <button @click="currentView = 'resources'" class="bg-brandDark hover:bg-white/10 border border-white/10 rounded-2xl p-4 text-left transition-colors group">
                            <span class="text-2xl mb-2 block group-hover:scale-110 transition-transform origin-left">📁</span>
                            <span class="font-bold text-sm text-white block">Resource Library</span>
