                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                            <span>Attendee List ({{ evt.rsvp_count || 0 }})</span>
                        </button>
                        <button @click="deleteEvent(evt.id)" class="p-2 rounded-xl text-slate-400 hover:text-red-400 hover:bg-red-500/10 transition-colors" title="Delete Event">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Empty State -->
            <div v-if="eventsList.length === 0" class="p-12 text-center glass bg-cardDark rounded-3xl border border-white/10">
                <p class="text-slate-400 mb-4">No community events scheduled yet.</p>
                <button @click="showAddEvent = true" class="px-5 py-2.5 rounded-xl bg-accent text-white font-bold text-xs">
                    Create First Gathering
                </button>
            </div>
        </div>

        <!-- CREATE EVENT MODAL -->
        <div v-if="showAddEvent" class="fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4">
            <div class="glass bg-[#1E293B] border border-white/10 rounded-3xl max-w-lg w-full p-6 space-y-4 max-h-[90vh] overflow-y-auto">
                <div class="flex items-center justify-between pb-3 border-b border-white/10">
                    <h3 class="text-xl font-bold text-white">Create Community Event</h3>
                    <button @click="showAddEvent = false" class="text-slate-400 hover:text-white">&times;</button>
                </div>

                <div class="space-y-4 text-xs">
                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Event Title *</label>
                        <input v-model="eventForm.title" type="text" placeholder="e.g. Tuesday YA Gathering" class="w-full p-2.5 rounded-xl bg-black/30 border border-white/10 text-white focus:outline-none focus:border-accent">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-slate-300 mb-1">Category</label>
                            <select v-model="eventForm.category" class="w-full p-2.5 rounded-xl bg-black/30 border border-white/10 text-white focus:outline-none focus:border-accent">
                                <option value="gathering">Tuesday Gathering</option>
                                <option value="prayer">Worship & Prayer</option>
                                <option value="fellowship">Tribal Fellowship</option>
                                <option value="service">City Outreach</option>
                                <option value="retreat">Retreat & Vision</option>
                            </select>
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-300 mb-1">Max Capacity (Seats)</label>
                            <input v-model.number="eventForm.capacity" type="number" placeholder="Leave empty if open" class="w-full p-2.5 rounded-xl bg-black/30 border border-white/10 text-white focus:outline-none focus:border-accent">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-slate-300 mb-1">Date * (YYYY-MM-DD)</label>
                            <input v-model="eventForm.date" type="date" class="w-full p-2.5 rounded-xl bg-black/30 border border-white/10 text-white focus:outline-none focus:border-accent">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-300 mb-1">Time</label>
                            <input v-model="eventForm.time" type="text" placeholder="7:00 PM - 9:00 PM" class="w-full p-2.5 rounded-xl bg-black/30 border border-white/10 text-white focus:outline-none focus:border-accent">
                        </div>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Location / Room</label>
                        <input v-model="eventForm.location" type="text" placeholder="EUC Sanctuary, 12604 New Hampshire Ave" class="w-full p-2.5 rounded-xl bg-black/30 border border-white/10 text-white focus:outline-none focus:border-accent">
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Description</label>
                        <textarea v-model="eventForm.description" rows="3" placeholder="Overview of the gathering, what to expect, or what to bring..." class="w-full p-2.5 rounded-xl bg-black/30 border border-white/10 text-white focus:outline-none focus:border-accent"></textarea>
                    </div>

                    <div class="flex items-center gap-2 pt-1">
                        <input v-model="eventForm.is_featured" type="checkbox" id="event-featured-chk" class="rounded">
                        <label for="event-featured-chk" class="text-slate-300 font-semibold cursor-pointer">Highlight as Featured Event</label>
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-3 border-t border-white/10">
                    <button @click="showAddEvent = false" class="px-4 py-2 rounded-xl text-slate-400 hover:text-white">Cancel</button>
                    <button @click="createEvent" class="px-5 py-2 rounded-xl bg-accent text-white font-bold hover:bg-blue-600 transition-colors">Publish Event</button>
                </div>
            </div>
        </div>

        <!-- NEWSLETTER & UPDATES VIEW -->
        <div v-show="currentView === 'newsletter' && !loading" class="space-y-6">
            <!-- Header bar -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h3 class="text-2xl font-bold text-white tracking-tight">Newsletter & Member Updates</h3>
                    <p class="text-slate-400 text-sm mt-1">
                        Send gathering announcements, devotionals, and updates directly to subscribed members.
                    </p>
                </div>
                <div class="flex items-center gap-3">
                    <button @click="copySubscribersEmails" class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition-all flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                        <span>Copy Active Emails</span>
                    </button>
                    <button @click="fetchNewsletter" class="p-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition-all" title="Refresh List">
                        <svg class="w-4 h-4" :class="loadingNewsletter ? 'animate-spin' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    </button>
                </div>
            </div>

            <!-- Stats Overview -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="glass bg-cardDark rounded-2xl p-5 border border-white/10">
                    <div class="flex items-center justify-between">
                        <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Total Subscribers</span>
                        <span class="p-2 rounded-xl bg-blue-500/10 text-blue-400">📬</span>
                    </div>
                    <div class="mt-3 flex items-baseline gap-2">
                        <span class="text-3xl font-black text-white">{{ newsletterSubscribers.length }}</span>
                        <span class="text-xs text-slate-400">all time</span>
                    </div>
                </div>

                <div class="glass bg-cardDark rounded-2xl p-5 border border-white/10">
                    <div class="flex items-center justify-between">
                        <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Active Subscribed</span>
                        <span class="p-2 rounded-xl bg-emerald-500/10 text-emerald-400">✓</span>
                    </div>
                    <div class="mt-3 flex items-baseline gap-2">
                        <span class="text-3xl font-black text-emerald-400">{{ activeSubscribersCount }}</span>
                        <span class="text-xs text-slate-400">ready to receive</span>
                    </div>
                </div>

                <div class="glass bg-cardDark rounded-2xl p-5 border border-white/10">
                    <div class="flex items-center justify-between">
                        <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Updates Sent</span>
                        <span class="p-2 rounded-xl bg-purple-500/10 text-purple-400">🚀</span>
                    </div>
                    <div class="mt-3 flex items-baseline gap-2">
                        <span class="text-3xl font-black text-purple-400">{{ newsletterBroadcasts.length }}</span>
                        <span class="text-xs text-slate-400">broadcasts</span>
                    </div>
                </div>
            </div>

            <!-- Main 2-Column Layout -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Left: Send Update Form -->
                <div class="lg:col-span-6 space-y-6">
                    <div class="glass bg-cardDark rounded-3xl p-6 sm:p-7 border border-white/10 space-y-5">
                        <div class="flex items-center justify-between">
                            <h4 class="text-lg font-bold text-white flex items-center gap-2">
                                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                <span>Send Update to Subscribed Users</span>
                            </h4>
                        </div>

                        <!-- Quick Templates -->
                        <div>
                            <span class="text-xs font-semibold text-slate-400 block mb-2">Quick Templates:</span>
                            <div class="flex flex-wrap gap-2">
                                <button type="button" @click="setNewsletterTemplate('tuesday')" class="px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/15 text-slate-300 hover:text-white text-xs transition-colors border border-white/5">
                                    Tuesday Gathering
                                </button>
                                <button type="button" @click="setNewsletterTemplate('events')" class="px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/15 text-slate-300 hover:text-white text-xs transition-colors border border-white/5">
                                    Events & Retreat
                                </button>
                                <button type="button" @click="setNewsletterTemplate('devotional')" class="px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/15 text-slate-300 hover:text-white text-xs transition-colors border border-white/5">
                                    Midweek Word
                                </button>
                            </div>
                        </div>

                        <!-- Form -->
                        <form @submit.prevent="sendNewsletterUpdate" class="space-y-4">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
                                    Email Subject Line
                                </label>
                                <input type="text" 
                                       v-model="newsletterForm.subject" 
                                       required 
                                       placeholder="e.g. Tuesday Gathering at 7:00 PM & Weekly Update" 
                                       class="w-full p-3 rounded-xl bg-black/40 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-accent">
                            </div>

                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
                                    Update Message
                                </label>
                                <textarea v-model="newsletterForm.message" 
                                          rows="6" 
                                          required 
                                          placeholder="Write your announcement or reflection for subscribed members here. Paragraph breaks will be formatted cleanly in the email." 
                                          class="w-full p-3 rounded-xl bg-black/40 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-accent leading-relaxed"></textarea>
                            </div>

                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">
                                    Send Test to Single Email Only (Optional)
                                </label>
                                <input type="email" 
                                       v-model="newsletterForm.testEmailOnly" 
                                       placeholder="Optional: Enter your email to test before broadcasting" 
                                       class="w-full p-3 rounded-xl bg-black/30 border border-white/10 text-white placeholder-slate-500 text-xs focus:outline-none focus:border-accent">
                            </div>

                            <!-- Alert banners -->
                            <div v-if="newsletterStatusMsg" class="p-3.5 rounded-xl bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 text-xs font-semibold flex items-center gap-2">
                                <svg class="w-4 h-4 shrink-0 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                <span>{{ newsletterStatusMsg }}</span>
                            </div>
                            <div v-if="newsletterErrorMsg" class="p-3.5 rounded-xl bg-rose-500/20 border border-rose-500/30 text-rose-300 text-xs font-semibold flex items-center gap-2">
                                <svg class="w-4 h-4 shrink-0 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                <span>{{ newsletterErrorMsg }}</span>
                            </div>

                            <div class="flex items-center justify-between pt-2">
                                <span class="text-xs text-slate-400">
                                    Audience: <strong class="text-white">{{ newsletterForm.testEmailOnly ? 'Test Recipient' : activeSubscribersCount + ' Active Subscriber(s)' }}</strong>
                                </span>
                                <button type="submit" 
                                        :disabled="sendingNewsletterUpdate || (!newsletterForm.testEmailOnly && activeSubscribersCount === 0)" 
                                        class="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm shadow-md transition-all flex items-center gap-2 disabled:opacity-50 cursor-pointer">
                                    <svg v-if="sendingNewsletterUpdate" class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                    <span v-if="sendingNewsletterUpdate">Sending Update...</span>
                                    <span v-else>Send Update Now &rarr;</span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Sent Broadcasts History -->
                    <div class="glass bg-cardDark rounded-3xl p-6 border border-white/10 space-y-4">
                        <h4 class="text-base font-bold text-white flex items-center gap-2">
                            <span>📜</span>
                            <span>Past Updates Broadcast History</span>
                        </h4>
                        <div v-if="newsletterBroadcasts.length === 0" class="text-center py-6 text-slate-400 text-xs">
                            No update broadcasts sent yet.
                        </div>
                        <div v-else class="space-y-3 max-h-64 overflow-y-auto pr-1 custom-scrollbar">
                            <div v-for="bc in newsletterBroadcasts" :key="bc.id" class="p-3.5 rounded-2xl bg-white/5 border border-white/5 space-y-1">
                                <div class="flex items-center justify-between text-xs">
                                    <strong class="text-white font-semibold">{{ bc.subject }}</strong>
                                    <span class="text-purple-400 font-bold">{{ bc.recipients_count }} recipient(s)</span>
                                </div>
                                <p class="text-slate-400 text-xs line-clamp-2 leading-relaxed">{{ bc.message }}</p>
                                <span class="text-[10px] text-slate-500 block">Sent: {{ new Date(bc.sent_at).toLocaleString() }} &bull; By {{ bc.sender_email || 'Leader' }}</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: Subscribers Management Table -->
                <div class="lg:col-span-6 space-y-4">
                    <div class="glass bg-cardDark rounded-3xl p-6 border border-white/10 space-y-4 flex flex-col h-full min-h-[500px]">
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                            <h4 class="text-base font-bold text-white flex items-center gap-2">
                                <span>👥</span>
                                <span>Subscribed Members ({{ filteredSubscribers.length }})</span>
                            </h4>
                            <input type="text" 
                                   v-model="newsletterSearch" 
                                   placeholder="Filter by email or name..." 
                                   class="p-2 rounded-xl bg-black/40 border border-white/10 text-white placeholder-slate-500 text-xs focus:outline-none focus:border-accent w-full sm:w-56">
                        </div>

                        <!-- Table -->
                        <div class="overflow-y-auto flex-1 border border-white/10 rounded-2xl">
                            <div v-if="loadingNewsletter" class="p-8 text-center text-slate-400 text-xs">
                                Loading subscribers...
                            </div>
                            <div v-else-if="filteredSubscribers.length === 0" class="p-8 text-center text-slate-400 text-xs">
                                No subscribers found matching search.
                            </div>
                            <table v-else class="w-full text-left text-xs text-slate-300">
                                <thead class="bg-black/30 text-slate-400 uppercase tracking-wider text-[10px] sticky top-0 border-b border-white/10">
                                    <tr>
                                        <th class="p-3">Subscriber</th>
                                        <th class="p-3">Status</th>
                                        <th class="p-3">Source</th>
                                        <th class="p-3 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-white/5">
                                    <tr v-for="sub in filteredSubscribers" :key="sub.id" class="hover:bg-white/5 transition-colors">
                                        <td class="p-3">
                                            <a :href="'mailto:' + sub.email" class="text-blue-400 hover:underline font-semibold block">{{ sub.email }}</a>
                                            <span v-if="sub.name" class="text-slate-400 text-[11px] block">{{ sub.name }}</span>
                                            <span class="text-slate-500 text-[10px] block">Joined: {{ sub.created_at ? sub.created_at.split('T')[0] : '—' }}</span>
                                        </td>
                                        <td class="p-3 whitespace-nowrap">
                                            <span :class="sub.status === 'subscribed' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-slate-500/20 text-slate-400'" class="px-2 py-0.5 rounded-full text-[10px] font-bold">
                                                {{ sub.status || 'subscribed' }}
                                            </span>
                                        </td>
                                        <td class="p-3 text-slate-400 text-[11px] whitespace-nowrap">
                                            {{ sub.source || 'footer_form' }}
                                        </td>
                                        <td class="p-3 text-right whitespace-nowrap">
                                            <button v-if="sub.status === 'subscribed'" @click="removeSubscriber(sub)" class="p-1.5 rounded-lg text-slate-400 hover:text-red-400 hover:bg-red-500/10 transition-colors" title="Unsubscribe">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ATTENDEES RSVP LIST MODAL -->
        <div v-if="showRsvpsModal" class="fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4">
            <div class="glass bg-[#1E293B] border border-white/10 rounded-3xl max-w-2xl w-full p-6 space-y-4 max-h-[90vh] flex flex-col">
                <div class="flex items-start justify-between pb-3 border-b border-white/10">
                    <div>
                        <h3 class="text-xl font-bold text-white">{{ activeEventForRsvps?.title }}</h3>
                        <p class="text-xs text-slate-400 mt-0.5">
                            {{ activeEventForRsvps?.date }} &bull; {{ activeEventForRsvps?.time }} &bull; {{ activeEventForRsvps?.location }}
                        </p>
                    </div>
                    <button @click="showRsvpsModal = false" class="text-slate-400 hover:text-white text-xl font-bold">&times;</button>
                </div>

                <!-- Summary Bar -->
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 p-3 rounded-2xl bg-white/5 border border-white/5 text-center text-xs">
                    <div>
                        <span class="text-slate-400 block">Registrations</span>
                        <strong class="text-lg text-white font-black">{{ activeRsvpsList.length }}</strong>
                    </div>
                    <div>
                        <span class="text-slate-400 block">Total People</span>
                        <strong class="text-lg text-emerald-400 font-black">
                            {{ activeRsvpsList.reduce((acc, r) => acc + 1 + (r.guests_count || 0), 0) }}
                        </strong>
                    </div>
                    <div class="col-span-2 sm:col-span-1">
                        <span class="text-slate-400 block">Total Guests</span>
                        <strong class="text-lg text-blue-400 font-black">
                            +{{ activeRsvpsList.reduce((acc, r) => acc + (r.guests_count || 0), 0) }}
                        </strong>
                    </div>
                </div>

                <!-- Attendee List Table -->
                <div class="overflow-y-auto flex-1 border border-white/10 rounded-2xl">
                    <div v-if="loadingRsvps" class="p-8 text-center text-slate-400 text-xs">
                        Loading attendee list...
                    </div>
                    <div v-else-if="activeRsvpsList.length === 0" class="p-8 text-center text-slate-400 text-xs">
                        No registrations for this event yet.
                    </div>
                    <table v-else class="w-full text-left text-xs text-slate-300">
                        <thead class="bg-black/30 text-slate-400 uppercase tracking-wider text-[10px] sticky top-0 border-b border-white/10">
                            <tr>
                                <th class="p-3">Attendee</th>
                                <th class="p-3">Contact</th>
                                <th class="p-3 text-center">Party Size</th>
                                <th class="p-3">Notes</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            <tr v-for="rsvp in activeRsvpsList" :key="rsvp.id" class="hover:bg-white/5 transition-colors">
                                <td class="p-3 font-semibold text-white whitespace-nowrap">
                                    {{ rsvp.name }}
                                </td>
                                <td class="p-3 whitespace-nowrap">
                                    <a :href="'mailto:' + rsvp.email" class="text-blue-400 hover:underline block">{{ rsvp.email }}</a>
                                    <span v-if="rsvp.phone" class="text-slate-400 text-[11px] block">{{ rsvp.phone }}</span>
                                </td>
                                <td class="p-3 text-center whitespace-nowrap">
                                    <span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-bold">
                                        {{ 1 + (rsvp.guests_count || 0) }}
                                    </span>
                                    <span v-if="rsvp.guests_count" class="text-[10px] text-slate-400 block mt-0.5">
                                        (+{{ rsvp.guests_count }} guest{{ rsvp.guests_count === 1 ? '' : 's' }})
                                    </span>
                                </td>
                                <td class="p-3 text-slate-400 max-w-xs truncate" :title="rsvp.notes">
                                    {{ rsvp.notes || '—' }}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="flex justify-end pt-2">
                    <button @click="showRsvpsModal = false" class="px-5 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition-colors">
                        Close
                    </button>
                </div>
            </div>
        </div>
</main>
</div>

<script type="module" src="/static/js/dashboard/main.js"></script>


</body>
</html>
