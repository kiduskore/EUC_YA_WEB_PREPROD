        <div class="absolute inset-0 bg-[url('/static/hero_images/crowd_praying.jpg')] bg-cover bg-center"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-white/80 via-white/70 to-[#FAFAFA] dark:from-[#0b1437]/90 dark:via-[#0b1437]/80 dark:to-[#0b1437]"></div>
        
        <div class="relative z-10 text-center px-6 mt-16">
            <h1 class="text-5xl md:text-7xl font-extrabold text-gray-900 dark:text-white mb-4 tracking-tight drop-shadow-lg">Find Your People.</h1>
            <p class="text-xl md:text-2xl text-gray-700 dark:text-gray-300 font-medium max-w-2xl mx-auto drop-shadow-md">Battle isolation through authentic local groups.</p>
