<%- include('partials/header') %>
<div class="min-h-screen flex items-center pt-24 justify-center p-4 relative overflow-hidden bg-[#0b1437] text-white">
    <div class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-[#0075ff] rounded-full mix-blend-screen filter blur-[100px] opacity-20"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-96 h-96 bg-[#01b574] rounded-full mix-blend-screen filter blur-[100px] opacity-20"></div>

    <div class="w-full max-w-md p-8 relative z-10 text-center" style="background: #111c44; border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 1.25rem; box-shadow: 0 4px 24px rgba(0,0,0,0.2);">
        <div class="flex justify-center mb-6">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-[#0075ff] to-[#01b574] flex items-center justify-center shadow-[0_0_30px_rgba(0,117,255,0.4)]">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            </div>
        </div>
        
        <h2 class="text-2xl font-bold mb-2">
            <%= typeof t !== 'undefined' ? t('auth.resetPasswordTitle') : 'Reset Password' %>
        </h2>
        <p class="text-gray-400 text-sm mb-8">
            <%= typeof t !== 'undefined' ? t('auth.resetPasswordSubtitle') : 'Enter your new password below.' %>
        </p>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-500/10 border border-red-500/50 text-red-400 rounded-xl p-3 text-sm mb-6">
            <%= error %>
        </div>
        <% } %>

        <form method="POST" action="/reset-password" class="space-y-4 text-left">
            <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>">
            <div>
                <label class="block text-xs font-semibold text-gray-400 mb-1">
                    <%= typeof t !== 'undefined' ? t('auth.newPasswordLabel') : 'New Password' %>
                </label>
                <input type="password" name="new_password" required minlength="8" placeholder="••••••••" class="w-full bg-slate-800/60 border border-white/10 text-white rounded-xl p-4 outline-none focus:border-[#0075ff] transition-all">
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-400 mb-1">
                    <%= typeof t !== 'undefined' ? t('auth.confirmPasswordLabel') : 'Confirm Password' %>
                </label>
                <input type="password" name="confirm_password" required minlength="8" placeholder="••••••••" class="w-full bg-slate-800/60 border border-white/10 text-white rounded-xl p-4 outline-none focus:border-[#0075ff] transition-all">
            </div>
            
            <button type="submit" class="w-full bg-white text-gray-900 font-bold rounded-xl p-4 mt-4 transition-transform hover:scale-[1.02] active:scale-[0.98]">
                <%= typeof t !== 'undefined' ? t('auth.updatePasswordBtn') : 'Update Password' %>
            </button>
        </form>
    </div>
</div>
<%- include('partials/footer') %>
