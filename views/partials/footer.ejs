                    <a href="/privacy" class="hover:text-blue-600 dark:hover:text-blue-400">Privacy</a>
                    <span>&bull;</span>
                    <a href="/terms" class="hover:text-blue-600 dark:hover:text-blue-400">Terms</a>
                    <span>&bull;</span>
                    <a href="/refund-policy" class="hover:text-blue-600 dark:hover:text-blue-400">Refunds</a>
                    <span>&bull;</span>
                    <a href="/cookie-policy" class="hover:text-blue-600 dark:hover:text-blue-400">Cookies</a>
                    <span>&bull;</span>
                    <a href="/privacy/data-deletion" class="hover:text-rose-500">Erasure</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Interactive Cookie Consent Banner -->
    <%- include('cookie-banner') %>


    <!-- JavaScript -->
    <script>
        document.getElementById('year').textContent = new Date().getFullYear();

        // Intersection Observer for scroll animations
        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    obs.unobserve(entry.target);
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

        // Fetch Public Resources
        async function fetchPublicResources() {
            try {
                const res = await fetch('/api/resources');
                if (res.ok) {
                    const data = await res.json();
                    const container = document.getElementById('public-resources');
                    if (!container) return;
                    
                    container.innerHTML = ''; // clear old loading state
                    
                    if (data.length === 0) {
                        const empty = document.createElement('div');
                        empty.className = 'text-center py-12 text-gray-900/50 dark:text-white/60 col-span-3';
                        empty.textContent = 'More resources coming soon!';
                        container.appendChild(empty);
                        return;
                    }

                    data.forEach(r => {
                        const card = document.createElement('div');
                        card.className = 'macos-card p-8 rounded-3xl flex flex-col h-full bg-white dark:bg-studio-900 border border-zinc-200/80 dark:border-white/5 hover:border-blue-500/30 hover:shadow-xl transition-all duration-300 group relative overflow-hidden flex-1 basis-[300px]';
                        
                        const bg = document.createElement('div');
                        bg.className = 'absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none';
                        card.appendChild(bg);

                        const inner = document.createElement('div');
                        inner.className = 'relative z-10 flex flex-col h-full';

                        const cat = document.createElement('span');
                        cat.className = 'inline-block px-3 py-1 bg-zinc-100 dark:bg-white/5 text-zinc-600 dark:text-zinc-400 text-[10px] font-black uppercase tracking-widest rounded-lg mb-6 w-max border border-zinc-200/50 dark:border-white/5';
                        cat.textContent = r.category;
                        inner.appendChild(cat);

                        const title = document.createElement('h3');
                        title.className = 'text-xl font-bold text-studio-900 dark:text-white mb-3 tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors';
                        title.textContent = r.title;
                        inner.appendChild(title);

                        const desc = document.createElement('p');
                        desc.className = 'text-zinc-600 dark:text-zinc-400 text-sm mb-8 flex-1 leading-relaxed';
                        desc.textContent = r.description || 'Discipleship resource';
                        inner.appendChild(desc);

                        const link = document.createElement('a');
                        link.href = r.file_url;
                        link.target = '_blank';
                        link.rel = 'noopener noreferrer';
                        link.className = 'inline-flex items-center gap-2 text-sm font-bold text-studio-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors mt-auto touch-manipulation group/link';
                        
                        const linkText = document.createTextNode('Open Resource ');
                        const arrow = document.createElement('span');
                        arrow.className = 'transform group-hover/link:translate-x-1 transition-transform';
                        arrow.textContent = '→';
                        
                        link.appendChild(linkText);
                        link.appendChild(arrow);
                        inner.appendChild(link);

                        card.appendChild(inner);
                        container.appendChild(card);
                    });
                }
            } catch (err) {
                console.error(err);
            }
        }

        document.addEventListener('DOMContentLoaded', fetchPublicResources);

        // Handle Contact Form Submit
        const contactForm = document.getElementById('contact-form');
        if (contactForm) {
            contactForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = document.getElementById('contact-submit');
                const successMsg = document.getElementById('contact-success');
                const originalText = btn.textContent;
                btn.textContent = 'Sending...';
                btn.disabled = true;

                const name = document.getElementById('contact-name').value;
                const email = document.getElementById('contact-email').value;
                const phone = document.getElementById('contact-phone').value;
                const notes = document.getElementById('contact-notes').value;
                const interestEl = document.getElementById('contact-interest');
                const interest = interestEl ? interestEl.value : '';
                const csrfMeta = document.querySelector('meta[name="csrf-token"]');
                const csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : '';

                try {
                    if (interest === 'prayer') {
                        await fetch('/api/prayer', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
                            body: JSON.stringify({ 
                                requester_name: name || 'Anonymous',
                                request_text: notes || 'Prayer request from website'
                            })
                        });
                    } else {
                        await fetch('/api/pipeline', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
                            body: JSON.stringify({ name, email, phone, notes, interest })
                        });
                    }
                    
                    contactForm.reset();
                    successMsg.classList.remove('hidden');
                    setTimeout(() => successMsg.classList.add('hidden'), 5000);
                } catch (err) {
                    console.error("Failed to submit form:", err);
                    alert("Something went wrong. Please try again.");
                } finally {
                    btn.textContent = originalText;
                    btn.disabled = false;
                }
            });
        }
    </script>

    <!-- Dark Mode Script -->
    <script>
        var themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
        var themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');

        if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            if (themeToggleLightIcon) themeToggleLightIcon.classList.remove('hidden');
            document.documentElement.classList.add('dark');
        } else {
            if (themeToggleDarkIcon) themeToggleDarkIcon.classList.remove('hidden');
            document.documentElement.classList.remove('dark');
        }

        // Mobile Menu Toggle
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        
        let scrollPosition = 0;
        function closeMobileMenu() {
            if (mobileMenu && mobileMenu.style.display === 'block') {
                mobileMenu.style.opacity = '0';
                mobileMenu.style.pointerEvents = 'none';
                setTimeout(() => {
                    mobileMenu.style.display = 'none';
                }, 300);
                
                // Bulletproof iOS Scroll Unlock
                document.body.style.overflow = '';
                document.body.style.position = '';
                document.body.style.top = '';
                document.body.style.width = '';
                window.scrollTo(0, scrollPosition);
            }
        }
        
        if (mobileBtn && mobileMenu) {
            mobileBtn.addEventListener('click', () => {
                if (mobileMenu.style.display === 'none' || mobileMenu.style.display === '') {
                    // Bulletproof iOS Scroll Lock
                    scrollPosition = window.pageYOffset;
                    document.body.style.overflow = 'hidden';
                    document.body.style.position = 'fixed';
                    document.body.style.top = `-${scrollPosition}px`;
                    document.body.style.width = '100%';
                    
                    mobileMenu.style.display = 'block';
                    // Small delay to allow display:block to apply before animating opacity
                    setTimeout(() => {
                        mobileMenu.style.opacity = '1';
                        mobileMenu.style.pointerEvents = 'auto';
                    }, 10);
                } else {
                    closeMobileMenu();
                }
            });
            
            // Fix iPad rotation bug: Close menu if screen resizes to desktop width
            window.addEventListener('resize', () => {
                if (window.innerWidth >= 1024) {
                    closeMobileMenu();
                }
            });
        }

        var themeToggleBtn = document.getElementById('theme-toggle');
        if (themeToggleBtn) {
            themeToggleBtn.addEventListener('click', function() {
                if (themeToggleDarkIcon) themeToggleDarkIcon.classList.toggle('hidden');
                if (themeToggleLightIcon) themeToggleLightIcon.classList.toggle('hidden');

                if (localStorage.getItem('color-theme')) {
                    if (localStorage.getItem('color-theme') === 'light') {
                        document.documentElement.classList.add('dark');
                        localStorage.setItem('color-theme', 'dark');
                    } else {
                        document.documentElement.classList.remove('dark');
                        localStorage.setItem('color-theme', 'light');
                    }
                } else {
                    if (document.documentElement.classList.contains('dark')) {
                        document.documentElement.classList.remove('dark');
                        localStorage.setItem('color-theme', 'light');
                    } else {
                        document.documentElement.classList.add('dark');
                        localStorage.setItem('color-theme', 'dark');
                    }
                }
            });
        }

        // Reading Progress Bar Logic
        window.addEventListener('scroll', () => {
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            const progressBar = document.getElementById('progress-bar');
            if(progressBar) {
                progressBar.style.width = scrolled + '%';
            }
        });

        // Initialize GSAP Animations safely
        function initAnimations() {
            try {
                if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
                    gsap.registerPlugin(ScrollTrigger);
                    
                    // Make elements visible right before animation
                    gsap.set(".gsap-reveal, .gsap-fade-up, .gsap-stagger-item, .gsap-scale-up", { visibility: "visible", opacity: 1 });

                    // Fade Up Elements
                    gsap.utils.toArray('.gsap-fade-up').forEach(elem => {
                        try {
                            gsap.from(elem, {
                                scrollTrigger: {
                                    trigger: elem,
                                    start: "top 88%",
                                    toggleActions: "play none none none"
                                },
                                y: 30,
                                opacity: 0,
                                duration: 0.8,
                                ease: "power3.out"
                            });
                        } catch(e) {}
                    });

                    // Scale Up Elements (Cards, Images)
                    gsap.utils.toArray('.gsap-scale-up').forEach(elem => {
                        try {
                            gsap.from(elem, {
                                scrollTrigger: {
                                    trigger: elem,
                                    start: "top 92%",
                                    toggleActions: "play none none none"
                                },
                                scale: 0.96,
                                opacity: 0,
                                duration: 0.8,
                                ease: "power2.out"
                            });
                        } catch(e) {}
                    });

                    // Staggered Grids
                    gsap.utils.toArray('.gsap-stagger-container').forEach(container => {
                        try {
                            const items = container.querySelectorAll('.gsap-stagger-item');
                            if(items.length > 0) {
                                gsap.from(items, {
                                    scrollTrigger: {
                                        trigger: container,
                                        start: "top 88%",
                                        toggleActions: "play none none none"
                                    },
                                    y: 20,
                                    opacity: 0,
                                    duration: 0.6,
                                    stagger: 0.08,
                                    ease: "power2.out"
                                });
                            }
                        } catch(e) {}
                    });
                }
            } catch(err) {
                console.warn('Animation init notice:', err);
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initAnimations);
        } else {
            initAnimations();
        }
    </script>

    <!-- Sticky Mobile CTA -->
    <%- include('mobile-cta') %>
</body>
</html>
