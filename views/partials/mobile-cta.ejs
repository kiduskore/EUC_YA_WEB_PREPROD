<% if (typeof currentPath === 'undefined' || (!currentPath.startsWith('/dashboard') && !currentPath.startsWith('/login') && !currentPath.startsWith('/member-form'))) { %>
<!-- Sticky Mobile Quick Action Bar (Warm Stone Editorial Design) -->
<aside aria-label="Quick Actions" class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-stone-50/95 dark:bg-stone-950/95 backdrop-blur-md border-t border-stone-200 dark:border-stone-800 px-4 py-2.5 shadow-[0_-4px_20px_rgba(28,25,23,0.06)] flex items-center justify-between gap-3 safe-area-inset-bottom">
    <div class="flex flex-col text-left">
        <span class="text-[10px] font-semibold text-warm-ochre dark:text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Tuesday Night Gathering
        </span>
        <span class="text-xs font-semibold text-stone-900 dark:text-stone-100">
            7:30 PM · 914 Silver Spring Ave
        </span>
    </div>
    <div class="flex items-center gap-2">
        <a href="/#weekly-gathering" class="px-3 py-2 rounded-lg bg-white dark:bg-stone-900 text-stone-800 dark:text-stone-200 text-xs font-semibold border border-stone-300 dark:border-stone-700 shadow-subtle active:scale-95 transition-all">
            Schedule
        </a>
        <a href="/#join" class="px-3.5 py-2 rounded-lg bg-stone-900 text-stone-50 hover:bg-stone-800 dark:bg-stone-100 dark:text-stone-900 text-xs font-semibold shadow-subtle active:scale-95 transition-all flex items-center gap-1">
            <span>Connect</span>
            <span aria-hidden="true">&rarr;</span>
        </a>
    </div>
</aside>
<% } %>
