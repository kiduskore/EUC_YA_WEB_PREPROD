    let currentSearchFilter = 'all';
    let currentHighlightedIndex = -1;
    let filteredSearchResults = [];

    // Global shortcut listener: Cmd+K / Ctrl+K or '/'
    document.addEventListener('keydown', function(e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
            e.preventDefault();
            toggleSiteSearchModal();
        } else if (e.key === '/' && !isTypingInInput(document.activeElement)) {
            e.preventDefault();
            openSiteSearchModal();
        } else if (e.key === 'Escape') {
            const modal = document.getElementById('site-search-modal');
            if (modal && !modal.classList.contains('hidden') && modal.style.display !== 'none') {
                closeSiteSearchModal();
            }
        }
    });

    function isTypingInInput(el) {
        if (!el) return false;
        const tag = el.tagName.toLowerCase();
        return tag === 'input' || tag === 'textarea' || el.isContentEditable;
    }

    function toggleSiteSearchModal() {
        const modal = document.getElementById('site-search-modal');
        if (modal && !modal.classList.contains('hidden') && modal.style.display !== 'none') {
            closeSiteSearchModal();
        } else {
            openSiteSearchModal();
        }
    }

    function openSiteSearchModal() {
        const modal = document.getElementById('site-search-modal');
        const input = document.getElementById('site-search-input');
        if (!modal) return;

        modal.classList.remove('hidden');
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';

        if (input) {
            input.focus();
            setTimeout(() => {
                input.focus();
                input.select();
            }, 30);
        }
        renderSearchResults();
    }

    function closeSiteSearchModal() {
        const modal = document.getElementById('site-search-modal');
        if (!modal) return;
        modal.classList.add('hidden');
        modal.style.display = 'none';
        document.body.style.overflow = '';
    }

    function navigateToResult(url) {
        closeSiteSearchModal();
        if (!url) return;

        // In-page hash scroll support (e.g. /#coming-soon-event or #resources)
        if (url.startsWith('#') || (url.startsWith('/#') && window.location.pathname === '/')) {
            const hash = url.startsWith('/#') ? url.substring(1) : url;
            const targetEl = document.querySelector(hash);
            if (targetEl) {
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                try {
                    history.pushState(null, '', hash);
                } catch(e) {}
                return;
            }
        }
        window.location.href = url;
    }

    function clearSearchInput() {
        const input = document.getElementById('site-search-input');
        if (!input) return;
        input.value = '';
        input.focus();
        document.getElementById('search-clear-btn').classList.add('hidden');
        renderSearchResults();
    }

    function setSearchFilter(filter) {
        currentSearchFilter = filter;
        document.querySelectorAll('.search-filter-pill').forEach(btn => {
            const match = btn.getAttribute('data-filter') === filter;
            if (match) {
                btn.className = 'search-filter-pill px-3 py-1 rounded-full font-bold transition-all bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 shrink-0 cursor-pointer';
            } else {
                btn.className = 'search-filter-pill px-3 py-1 rounded-full font-semibold transition-all bg-zinc-100 text-zinc-600 dark:bg-white/5 dark:text-zinc-400 hover:bg-zinc-200 dark:hover:bg-white/10 shrink-0 cursor-pointer';
            }
        });
        renderSearchResults();
    }

    function handleSearchQueryChange(val) {
        const clearBtn = document.getElementById('search-clear-btn');
        if (val && val.trim().length > 0) {
            clearBtn.classList.remove('hidden');
        } else {
            clearBtn.classList.add('hidden');
        }
        renderSearchResults();
    }

    function handleSearchModalSubmit(e) {
        // If there's an active highlighted item, navigate to it; otherwise let form submit to /search?q=...
        if (filteredSearchResults && filteredSearchResults.length > 0) {
            e.preventDefault();
            const target = filteredSearchResults[currentHighlightedIndex >= 0 ? currentHighlightedIndex : 0];
            if (target && target.url) {
                navigateToResult(target.url);
                return;
            }
        }
    }

    function handleSearchKeyNav(e) {
        if (e.key === 'ArrowDown') {
            e.preventDefault();
            moveHighlight(1);
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            moveHighlight(-1);
        } else if (e.key === 'Enter') {
            if (filteredSearchResults && filteredSearchResults.length > 0) {
                e.preventDefault();
                selectHighlightedResult();
            }
        }
    }

    function moveHighlight(delta) {
        const items = document.querySelectorAll('.search-result-item');
        if (!items || items.length === 0) return;
        currentHighlightedIndex += delta;
        if (currentHighlightedIndex >= items.length) currentHighlightedIndex = 0;
        if (currentHighlightedIndex < 0) currentHighlightedIndex = items.length - 1;
        
        items.forEach((item, idx) => {
            if (idx === currentHighlightedIndex) {
                item.classList.add('bg-zinc-100', 'dark:bg-white/10', 'ring-1', 'ring-blue-500/40');
                item.scrollIntoView({ block: 'nearest' });
            } else {
                item.classList.remove('bg-zinc-100', 'dark:bg-white/10', 'ring-1', 'ring-blue-500/40');
            }
        });
    }

    function selectHighlightedResult() {
        const items = document.querySelectorAll('.search-result-item');
        if (items && items[currentHighlightedIndex]) {
            const url = items[currentHighlightedIndex].getAttribute('data-url');
            if (url) navigateToResult(url);
            else items[currentHighlightedIndex].click();
        } else if (items && items[0]) {
            const url = items[0].getAttribute('data-url');
            if (url) navigateToResult(url);
            else items[0].click();
        }
    }

    function highlightMatch(text, query) {
        if (!text) return '';
        if (!query || !query.trim()) return text;
        const clean = query.trim();
        if (!clean) return text;
        try {
            const q = clean.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const regex = new RegExp(`(${q})`, 'gi');
            return text.replace(regex, `<mark class="bg-blue-500/25 text-blue-600 dark:text-blue-400 font-bold rounded px-0.5">$1</mark>`);
        } catch(e) {
            return text;
        }
    }

    function getStem(w) {
        if (!w) return '';
        if (w.length > 4 && w.endsWith('ing')) return w.slice(0, -3);
        if (w.length > 3 && w.endsWith('es')) return w.slice(0, -2);
        if (w.length > 3 && w.endsWith('s')) return w.slice(0, -1);
        return w;
    }

    function renderSearchResults() {
        const input = document.getElementById('site-search-input');
        const container = document.getElementById('search-results-container');
        const viewAllLink = document.getElementById('search-view-all-link');
        if (!container) return;

        const rawQuery = (input ? input.value : '').trim();
        // Safe query cleaning without Unicode regex errors
        const cleanQuery = rawQuery.toLowerCase().replace(/[\?\!\,\.\:\;\(\)\[\]\{\}\"\']/g, ' ').trim();
        currentHighlightedIndex = -1;

        if (viewAllLink) {
            viewAllLink.href = rawQuery ? `/search?q=${encodeURIComponent(rawQuery)}` : '/search';
            viewAllLink.innerHTML = rawQuery ? `<span>See all results for "${rawQuery}"</span> <span>→</span>` : `<span>Open Full Search Page</span> <span>→</span>`;
        }

        // Apply Category Filter
        let dataset = EUCMD_SEARCH_INDEX;
        if (currentSearchFilter !== 'all') {
            dataset = dataset.filter(item => item.category === currentSearchFilter);
        }

        // If query is empty, show popular topics and quick navigation
        if (!cleanQuery) {
            filteredSearchResults = dataset.slice(0, 6);
            container.innerHTML = `
                <div class="mb-4">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-2.5">
                        Popular Topics & Fast Links
                    </p>
                    <div class="flex flex-wrap gap-1.5 sm:gap-2">
                        <button onclick="applySearchTerm('Small Groups')" class="px-3 py-1.5 rounded-xl bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border border-indigo-500/30 hover:bg-indigo-500/20 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer">
                            <span>👥</span> Small Groups
                        </button>
                        <button onclick="applySearchTerm('Revive Us Again')" class="px-3 py-1.5 rounded-xl bg-teal-500/10 text-teal-700 dark:text-teal-300 border border-teal-500/30 hover:bg-teal-500/20 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer">
                            <span>✨</span> Revive Event
                        </button>
                        <button onclick="applySearchTerm('Salvation')" class="px-3 py-1.5 rounded-xl bg-blue-500/10 text-blue-700 dark:text-blue-300 border border-blue-500/30 hover:bg-blue-500/20 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer">
                            <span>✝️</span> Salvation
                        </button>
                        <button onclick="applySearchTerm('Water Baptism')" class="px-3 py-1.5 rounded-xl bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 border border-cyan-500/30 hover:bg-cyan-500/20 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer">
                            <span>💧</span> Baptism
                        </button>
                        <button onclick="applySearchTerm('Mentorship')" class="px-3 py-1.5 rounded-xl bg-purple-500/10 text-purple-700 dark:text-purple-300 border border-purple-500/30 hover:bg-purple-500/20 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer">
                            <span>🌱</span> Mentorship
                        </button>
                        <button onclick="applySearchTerm('Prayer')" class="px-3 py-1.5 rounded-xl bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/30 hover:bg-amber-500/20 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer">
                            <span>🙏</span> Prayer
                        </button>
                    </div>
                </div>

                <div class="pt-2">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-2">
                        Browse Core Pillars & Community
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        ${dataset.slice(0, 6).map((item, idx) => `
                            <div onclick="navigateToResult('${item.url}')" 
                                 data-url="${item.url}" 
                                 class="search-result-item flex items-center gap-3 p-3 rounded-2xl border border-zinc-100 dark:border-white/5 bg-zinc-50/50 dark:bg-studio-950/40 hover:bg-zinc-100 dark:hover:bg-white/5 transition-all text-left group cursor-pointer"
                                 data-index="${idx}">
                                <span class="text-xl p-2 rounded-xl bg-white dark:bg-studio-800 border border-zinc-200 dark:border-white/10 shadow-xs shrink-0">${item.icon}</span>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <h4 class="text-sm font-bold text-zinc-900 dark:text-white truncate group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">${item.title}</h4>
                                    </div>
                                    <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-1">${item.desc}</p>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
            return;
        }

        // Search Scoring Engine
        const stopWords = new Set(['what', 'are', 'the', 'is', 'a', 'to', 'for', 'in', 'how', 'do', 'of', 'and']);
        const allTerms = cleanQuery.split(/\s+/).filter(Boolean);
        const keyTerms = allTerms.filter(t => !stopWords.has(t));
        const termsToMatch = keyTerms.length > 0 ? keyTerms : allTerms;

        filteredSearchResults = dataset.map(item => {
            let score = 0;
            const fullText = `${item.title} ${item.desc} ${item.keywords} ${item.pillar}`.toLowerCase();
            
            // Exact full query match
            if (cleanQuery.length > 1 && fullText.includes(cleanQuery)) {
                score += 100;
            }

            // Title exact match
            if (item.title.toLowerCase().includes(cleanQuery)) {
                score += 80;
            }

            // Individual terms
            for (const t of termsToMatch) {
                const stem = getStem(t);
                if (item.title.toLowerCase().includes(t)) {
                    score += 40;
                } else if (stem && item.title.toLowerCase().includes(stem)) {
                    score += 25;
                }

                if (item.keywords.toLowerCase().includes(t)) {
                    score += 30;
                } else if (stem && item.keywords.toLowerCase().includes(stem)) {
                    score += 20;
                }

                if (item.desc.toLowerCase().includes(t)) {
                    score += 15;
                } else if (stem && item.desc.toLowerCase().includes(stem)) {
                    score += 10;
                }
            }

            return { item, score };
        }).filter(res => res.score > 0)
          .sort((a, b) => b.score - a.score)
          .map(res => res.item);

        if (filteredSearchResults.length === 0) {
            container.innerHTML = `
                <div class="py-12 text-center">
                    <div class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-zinc-100 dark:bg-white/5 border border-zinc-200 dark:border-white/10 flex items-center justify-center text-2xl text-zinc-400">
                        🔍
                    </div>
                    <h3 class="text-base font-bold text-zinc-900 dark:text-white mb-1">No direct results for "${rawQuery}"</h3>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 max-w-sm mx-auto mb-4">
                        Try searching for "small groups", "community", "discipleship", "salvation", "worship", or "prayer".
                    </p>
                    <div class="flex items-center justify-center gap-2">
                        <button onclick="clearSearchInput()" class="px-4 py-2 rounded-full text-xs font-bold bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 hover:opacity-90 active:scale-95 transition-all cursor-pointer">
                            Clear Search
                        </button>
                        <a href="/search?q=${encodeURIComponent(rawQuery)}" class="px-4 py-2 rounded-full text-xs font-bold bg-blue-600 text-white hover:bg-blue-500 active:scale-95 transition-all cursor-pointer">
                            Search Whole Site
                        </a>
                    </div>
                </div>
            `;
            return;
        }

        // Render Results List
        container.innerHTML = `
            <div class="flex items-center justify-between mb-2 px-1">
                <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
                    Matching Results (${filteredSearchResults.length})
                </span>
                <span class="text-[11px] text-zinc-400">Press ↵ or click to open</span>
            </div>
            <div class="space-y-2">
                ${filteredSearchResults.map((item, idx) => `
                    <div onclick="navigateToResult('${item.url}')" 
                         data-url="${item.url}" 
                         class="search-result-item flex items-start gap-3.5 p-3.5 rounded-2xl border border-zinc-200/80 dark:border-white/5 bg-zinc-50/50 dark:bg-studio-950/40 hover:bg-zinc-100 dark:hover:bg-white/10 active:scale-[0.99] transition-all text-left group cursor-pointer" 
                         data-index="${idx}">
                        <div class="w-10 h-10 rounded-xl bg-white dark:bg-studio-800 border border-zinc-200 dark:border-white/10 flex items-center justify-center text-lg shrink-0 shadow-xs group-hover:scale-105 transition-transform">
                            ${item.icon}
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2 mb-1">
                                <span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider border ${item.badgeColor}">
                                    ${item.pillar}
                                </span>
                                <h4 class="text-sm font-bold text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                                    ${highlightMatch(item.title, cleanQuery)}
                                </h4>
                            </div>
                            <p class="text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed">
                                ${highlightMatch(item.desc, cleanQuery)}
                            </p>
                        </div>
                        <span class="text-zinc-400 group-hover:text-blue-500 group-hover:translate-x-0.5 transition-all text-sm mt-2 shrink-0">
                            →
                        </span>
                    </div>
                `).join('')}
            </div>
        `;
    }

    function applySearchTerm(term) {
        const input = document.getElementById('site-search-input');
        if (!input) return;
        input.value = term;
        handleSearchQueryChange(term);
    }

    function triggerMobileSearch() {
        const mobileMenu = document.getElementById('mobile-menu');
        if (mobileMenu) {
            mobileMenu.style.display = 'none';
            mobileMenu.style.opacity = '0';
            mobileMenu.style.pointerEvents = 'none';
        }
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.width = '';
        openSiteSearchModal();
    }

    // Attach click triggers to all elements with class .trigger-site-search
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.trigger-site-search').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                openSiteSearchModal();
            });
        });
    });

    // Expose all functions globally on window
    window.openSiteSearchModal = openSiteSearchModal;
    window.closeSiteSearchModal = closeSiteSearchModal;
    window.toggleSiteSearchModal = toggleSiteSearchModal;
    window.triggerMobileSearch = triggerMobileSearch;
    window.applySearchTerm = applySearchTerm;
    window.navigateToResult = navigateToResult;
    window.setSearchFilter = setSearchFilter;
    window.clearSearchInput = clearSearchInput;
    window.handleSearchQueryChange = handleSearchQueryChange;
    window.handleSearchKeyNav = handleSearchKeyNav;
    window.handleSearchModalSubmit = handleSearchModalSubmit;
</script>
