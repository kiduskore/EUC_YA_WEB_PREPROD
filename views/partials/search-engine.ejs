<!-- Global Site Search Engine & Command Palette Modal (Ctrl+K / Cmd+K) -->
<div id="site-search-modal" 
     class="fixed inset-0 z-[99999] flex items-start justify-center p-3 sm:p-6 md:p-10 transition-all duration-150 hidden" 
     style="display: none;" 
     role="dialog" 
     aria-modal="true" 
     aria-labelledby="site-search-title">
    
    <!-- Backdrop Blur with click-to-dismiss -->
    <div class="fixed inset-0 bg-zinc-950/80 backdrop-blur-md transition-opacity cursor-pointer" 
         onclick="closeSiteSearchModal()" 
         aria-hidden="true"></div>

    <!-- Search Modal Card -->
    <div class="relative w-full max-w-2xl bg-white dark:bg-studio-900 border border-zinc-200 dark:border-white/10 rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[85vh] z-[100000] scale-100" 
         id="site-search-dialog">
        
        <!-- Search Input Bar Form -->
        <form action="/search" method="GET" class="m-0 p-0" onsubmit="handleSearchModalSubmit(event)">
            <div class="relative flex items-center px-4 sm:px-6 py-4 border-b border-zinc-200 dark:border-white/10 bg-zinc-50/70 dark:bg-studio-950/70">
                <span class="text-blue-500 mr-3 shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </span>
                <input type="text" 
                       name="q"
                       id="site-search-input" 
                       placeholder="Search salvation, small groups, scriptures, events..." 
                       class="w-full bg-transparent text-zinc-900 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-500 text-base sm:text-lg font-medium focus:outline-none focus:ring-0 border-none p-0"
                       autocomplete="off" 
                       spellcheck="false"
                       oninput="handleSearchQueryChange(this.value)"
                       onkeydown="handleSearchKeyNav(event)">
                
                <!-- Clear Button -->
                <button id="search-clear-btn" 
                        type="button" 
                        onclick="clearSearchInput()" 
                        class="hidden p-1.5 rounded-lg text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 transition-colors mr-2 cursor-pointer"
                        aria-label="Clear search input">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
                
                <!-- ESC Close Badge -->
                <button type="button" 
                        onclick="closeSiteSearchModal()" 
                        class="px-2.5 py-1 text-xs font-semibold font-mono text-zinc-500 dark:text-zinc-400 bg-zinc-200/80 dark:bg-white/10 rounded-lg hover:bg-zinc-300 dark:hover:bg-white/20 transition-all select-none cursor-pointer">
                    ESC
                </button>
            </div>
        </form>

        <!-- Filter Chips Bar -->
        <div class="flex items-center gap-1.5 px-4 sm:px-6 py-2.5 bg-white dark:bg-studio-900 border-b border-zinc-100 dark:border-white/5 overflow-x-auto no-scrollbar text-xs">
            <span class="text-zinc-400 dark:text-zinc-500 font-semibold mr-1 shrink-0">Filter:</span>
            <button type="button" onclick="setSearchFilter('all')" class="search-filter-pill px-3 py-1 rounded-full font-bold transition-all bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 shrink-0 cursor-pointer" data-filter="all">All</button>
            <button type="button" onclick="setSearchFilter('teachings')" class="search-filter-pill px-3 py-1 rounded-full font-semibold transition-all bg-zinc-100 text-zinc-600 dark:bg-white/5 dark:text-zinc-400 hover:bg-zinc-200 dark:hover:bg-white/10 shrink-0 cursor-pointer" data-filter="teachings">Teachings</button>
            <button type="button" onclick="setSearchFilter('events')" class="search-filter-pill px-3 py-1 rounded-full font-semibold transition-all bg-zinc-100 text-zinc-600 dark:bg-white/5 dark:text-zinc-400 hover:bg-zinc-200 dark:hover:bg-white/10 shrink-0 cursor-pointer" data-filter="events">Events</button>
            <button type="button" onclick="setSearchFilter('groups')" class="search-filter-pill px-3 py-1 rounded-full font-semibold transition-all bg-zinc-100 text-zinc-600 dark:bg-white/5 dark:text-zinc-400 hover:bg-zinc-200 dark:hover:bg-white/10 shrink-0 cursor-pointer" data-filter="groups">Small Groups</button>
            <button type="button" onclick="setSearchFilter('scriptures')" class="search-filter-pill px-3 py-1 rounded-full font-semibold transition-all bg-zinc-100 text-zinc-600 dark:bg-white/5 dark:text-zinc-400 hover:bg-zinc-200 dark:hover:bg-white/10 shrink-0 cursor-pointer" data-filter="scriptures">Scriptures</button>
            <button type="button" onclick="setSearchFilter('faqs')" class="search-filter-pill px-3 py-1 rounded-full font-semibold transition-all bg-zinc-100 text-zinc-600 dark:bg-white/5 dark:text-zinc-400 hover:bg-zinc-200 dark:hover:bg-white/10 shrink-0 cursor-pointer" data-filter="faqs">FAQs</button>
        </div>

        <!-- Search Results Scroll Area -->
        <div id="search-results-container" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-3 overscroll-contain">
            <!-- Results dynamically injected here -->
        </div>

        <!-- Search Modal Footer -->
        <div class="px-4 sm:px-6 py-3 border-t border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-studio-950/60 flex items-center justify-between text-xs text-zinc-500 dark:text-zinc-400">
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-1">
                    <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-white/10 font-mono text-[10px]">↑</kbd>
                    <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-white/10 font-mono text-[10px]">↓</kbd>
                    Navigate
                </span>
                <span class="inline-flex items-center gap-1">
                    <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-white/10 font-mono text-[10px]">↵</kbd>
                    Open
                </span>
            </div>
            <a id="search-view-all-link" href="/search" class="text-blue-600 dark:text-blue-400 font-bold hover:underline flex items-center gap-1 cursor-pointer">
                <span>Open Full Search Page</span>
                <span>→</span>
            </a>
        </div>
    </div>
</div>

