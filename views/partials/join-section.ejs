    <section id="join" class="py-20 sm:py-28 relative overflow-hidden bg-stone-100/60 dark:bg-stone-900/40 border-t border-stone-200/80 dark:border-stone-850">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
            
            <!-- Left Info Column -->
            <div class="lg:col-span-5 space-y-8">
                <div>
                    <span class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-500 dark:text-stone-400 block mb-2">
                        <%= typeof t !== 'undefined' ? t('connect.tag') : 'Connect With Us' %>
                    </span>
                    <h2 class="text-3xl sm:text-5xl font-serif font-bold tracking-tight text-stone-900 dark:text-stone-100 leading-tight mb-4">
                        We would love to welcome you.
                    </h2>
                    <p class="text-stone-600 dark:text-stone-300 text-sm sm:text-base leading-relaxed">
                        Whether you are visiting for the first time, looking for a life pod in your neighborhood, or have questions about faith in Christ, reach out to our team.
                    </p>
                </div>
                
                <div class="space-y-4">
                    <!-- Tuesday Gathering Box -->
                    <div class="p-6 rounded-2xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-subtle">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-warm-ochre dark:text-amber-400 block mb-1">Weekly Young Adults Gathering</span>
                        <h3 class="font-serif font-bold text-stone-900 dark:text-stone-100 text-lg mb-1">
                            Tuesday Nights at 7:30 PM
                        </h3>
                        <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm leading-relaxed mb-3">
                            914 Silver Spring Ave, Suite 204B, Silver Spring, MD 20910.<br/>
                            Followed by fellowship, tea, coffee, and prayer circles.
                        </p>
                        <a href="https://maps.google.com/?q=914+Silver+Spring+Ave+204B,+Silver+Spring,+MD+20910" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-semibold text-stone-900 dark:text-stone-200 hover:text-warm-ochre dark:hover:text-amber-400 transition-colors">
                            <span>Get Directions (Google Maps)</span>
                            <span aria-hidden="true">&rarr;</span>
                        </a>
                    </div>

                    <!-- Sunday Church Service Box -->
                    <div class="p-6 rounded-2xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-subtle">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500 block mb-1">Sunday Worship with EUC Church Family</span>
                        <h3 class="font-serif font-bold text-stone-900 dark:text-stone-100 text-lg mb-1">
                            Sundays at 10:30 AM
                        </h3>
                        <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm leading-relaxed mb-3">
                            Emmanuel United Church of Maryland<br/>
                            12604 New Hampshire Ave, Silver Spring, MD 20904
                        </p>
                        <a href="https://eucmaryland.org" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-semibold text-stone-900 dark:text-stone-200 hover:text-warm-ochre dark:hover:text-amber-400 transition-colors">
                            <span>Visit Church Website (eucmaryland.org)</span>
                            <span aria-hidden="true">&nearr;</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Contact Form Card -->
            <div id="contact" class="lg:col-span-7 bg-white dark:bg-stone-900 p-8 sm:p-10 rounded-3xl border border-stone-200 dark:border-stone-800 shadow-editorial dark:shadow-editorial-dark">
                <div class="mb-6">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-warm-ochre dark:text-amber-400 block mb-1">
                        Direct Inquiry
                    </span>
                    <h3 class="text-2xl font-serif font-bold tracking-tight text-stone-900 dark:text-stone-100">
                        <%= typeof t !== 'undefined' ? t('contact.tag') : 'Send a Note to Our Leadership' %>
                    </h3>
                    <p class="text-xs text-stone-500 dark:text-stone-400 mt-1">
                        <%= typeof t !== 'undefined' ? t('contact.subtitle') : 'Share your details and one of our pastors or life pod leaders will personally connect with you.' %>
                    </p>
                </div>

                <form id="contact-form" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-stone-700 dark:text-stone-300 mb-1.5 tracking-wider uppercase">
                            <%= typeof t !== 'undefined' ? t('contact.nameLabel') : 'YOUR FULL NAME' %>
                        </label>
                        <input type="text" id="contact-name" required placeholder="<%= typeof t !== 'undefined' ? t('contact.namePlaceholder') : 'Full Name' %>" class="w-full bg-stone-50 dark:bg-stone-800/60 border border-stone-300 dark:border-stone-700 rounded-xl px-4 py-3 text-stone-900 dark:text-white placeholder-stone-400 text-xs sm:text-sm focus:outline-none focus:border-stone-900 dark:focus:border-stone-100 transition-colors">
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-stone-700 dark:text-stone-300 mb-1.5 tracking-wider uppercase">
                                <%= typeof t !== 'undefined' ? t('contact.emailLabel') : 'EMAIL ADDRESS' %>
                            </label>
                            <input type="email" id="contact-email" required placeholder="<%= typeof t !== 'undefined' ? t('contact.emailPlaceholder') : 'name@example.com' %>" class="w-full bg-stone-50 dark:bg-stone-800/60 border border-stone-300 dark:border-stone-700 rounded-xl px-4 py-3 text-stone-900 dark:text-white placeholder-stone-400 text-xs sm:text-sm focus:outline-none focus:border-stone-900 dark:focus:border-stone-100 transition-colors">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-stone-700 dark:text-stone-300 mb-1.5 tracking-wider uppercase">
                                <%= typeof t !== 'undefined' ? t('contact.phoneLabel') : 'PHONE NUMBER' %>
                            </label>
                            <input type="tel" id="contact-phone" placeholder="<%= typeof t !== 'undefined' ? t('contact.phonePlaceholder') : '(301) 555-0199' %>" class="w-full bg-stone-50 dark:bg-stone-800/60 border border-stone-300 dark:border-stone-700 rounded-xl px-4 py-3 text-stone-900 dark:text-white placeholder-stone-400 text-xs sm:text-sm focus:outline-none focus:border-stone-900 dark:focus:border-stone-100 transition-colors">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-stone-700 dark:text-stone-300 mb-1.5 tracking-wider uppercase">
                            <%= typeof t !== 'undefined' ? t('contact.interestLabel') : 'HOW CAN WE HELP YOU?' %>
                        </label>
                        <select id="contact-interest" class="w-full bg-stone-50 dark:bg-stone-800/60 border border-stone-300 dark:border-stone-700 rounded-xl px-4 py-3 text-stone-900 dark:text-white text-xs sm:text-sm focus:outline-none focus:border-stone-900 dark:focus:border-stone-100 transition-colors">
                            <option value="gathering"><%= typeof t !== 'undefined' ? t('contact.interest.gathering') : 'Attending a Tuesday Gathering' %></option>
                            <option value="smallgroup"><%= typeof t !== 'undefined' ? t('contact.interest.smallgroup') : 'Joining a Small Group Life Pod' %></option>
                            <option value="serving"><%= typeof t !== 'undefined' ? t('contact.interest.serving') : 'Serving Opportunities' %></option>
                            <option value="prayer"><%= typeof t !== 'undefined' ? t('contact.interest.prayer') : 'Prayer Request' %></option>
                            <option value="other"><%= typeof t !== 'undefined' ? t('contact.interest.other') : 'General Question' %></option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-stone-700 dark:text-stone-300 mb-1.5 tracking-wider uppercase">
                            <%= typeof t !== 'undefined' ? t('contact.messageLabel') : 'YOUR MESSAGE' %>
                        </label>
                        <textarea id="contact-notes" rows="3" placeholder="<%= typeof t !== 'undefined' ? t('contact.messagePlaceholder') : 'Tell us a bit about yourself or how we can pray for you...' %>" class="w-full bg-stone-50 dark:bg-stone-800/60 border border-stone-300 dark:border-stone-700 rounded-xl p-4 text-stone-900 dark:text-white placeholder-stone-400 text-xs sm:text-sm focus:outline-none focus:border-stone-900 dark:focus:border-stone-100 transition-colors resize-none"></textarea>
                    </div>

                    <!-- Explicit Privacy & Age Consents (Anti-Dark Pattern, Unchecked by default) -->
                    <div class="space-y-2 pt-2 text-left">
                        <label class="flex items-start gap-2.5 cursor-pointer select-none">
                            <input type="checkbox" id="contact-consent" required class="mt-0.5 w-3.5 h-3.5 rounded border-stone-300 text-stone-900">
                            <span class="text-xs text-stone-600 dark:text-stone-400 leading-normal">
                                I consent to Emmanuel United Church of MD storing my contact details to reply to my inquiry in accordance with the <a href="/privacy" target="_blank" class="text-stone-900 dark:text-stone-200 underline font-medium">Privacy Policy</a>.
                            </span>
                        </label>
                        <label class="flex items-start gap-2.5 cursor-pointer select-none">
                            <input type="checkbox" id="contact-age-consent" required class="mt-0.5 w-3.5 h-3.5 rounded border-stone-300 text-stone-900">
                            <span class="text-xs text-stone-600 dark:text-stone-400 leading-normal">
                                I confirm I am 18 years of age or older (or 13–17 with parental/guardian permission).
                            </span>
                        </label>
                    </div>
                    
                    <div id="contact-success" class="hidden bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-500/30 text-emerald-800 dark:text-emerald-300 rounded-xl p-4 text-xs font-medium flex items-center gap-3">
                        <span class="text-emerald-600 font-bold text-base">✓</span>
                        <span><%= typeof t !== 'undefined' ? t('contact.success') : 'Thank you! Your message has been received. A ministry leader will connect with you shortly.' %></span>
                    </div>

                    <button type="submit" id="contact-submit" class="w-full bg-stone-900 text-stone-50 hover:bg-stone-800 dark:bg-stone-100 dark:text-stone-900 dark:hover:bg-white font-semibold rounded-xl min-h-[50px] transition-all shadow-subtle text-xs tracking-wide touch-manipulation active:scale-[0.98]">
                        <%= typeof t !== 'undefined' ? t('contact.submitBtn') : 'Send Note & Connect' %> &rarr;
                    </button>
                </form>
            </div>
        </div>
    </section>
