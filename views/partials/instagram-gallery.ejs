<section id="community-gallery" class="py-24 relative overflow-hidden bg-white dark:bg-[#0a0a0a] border-t border-zinc-200/50 dark:border-white/5">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <!-- Section Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
            <div class="max-w-2xl">
                <span class="text-blue-600 dark:text-blue-400 font-bold tracking-widest uppercase text-xs mb-3 block">Our Community</span>
                <h2 class="text-3xl md:text-5xl font-black tracking-tight text-studio-900 dark:text-white leading-tight">
                    Life at EUC YA
                </h2>
                <p class="mt-4 text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed">
                    Moments of worship, fellowship, and discipleship. Follow our journey on Instagram.
                </p>
            </div>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-zinc-100 dark:bg-white/5 text-studio-900 dark:text-white font-bold rounded-full hover:bg-zinc-200 dark:hover:bg-white/10 transition-colors shrink-0 group">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                Follow @EUC_YA <span class="transform group-hover:translate-x-1 transition-transform">→</span>
            </a>
        </div>

        <!-- Masonry Grid -->
        <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
            <% 
                const igImages = [
                    '2026-05-08_01-45-38_UTC_3.jpg',
                    '2026-05-08_01-45-38_UTC_13.jpg',
                    '2026-04-15_18-30-38_UTC.jpg',
                    '2026-05-03_16-30-16_UTC_1.jpg',
                    '2026-05-08_01-45-38_UTC_17.jpg',
                    '2026-04-26_20-52-21_UTC.jpg',
                    '2026-05-01_13-57-58_UTC.jpg',
                    '2026-05-08_01-45-38_UTC_7.jpg',
                    '2026-04-25_18-17-51_UTC.jpg'
                ];
            %>
            <% igImages.forEach(img => { %>
                <div class="break-inside-avoid relative group rounded-2xl overflow-hidden cursor-pointer transform hover:-translate-y-1 transition-all duration-500 shadow-sm hover:shadow-2xl mb-6">
                    <img src="/static/ig_images/<%= img %>" alt="Community Moment" class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                    <!-- Overlay -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-black/0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
                        <div class="flex items-center gap-3 text-white transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                            <span class="font-bold text-sm">View on Instagram</span>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</section>
