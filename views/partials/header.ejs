<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="ltr">
<head>
    <meta name="description" content="Emmanuel United Church of Maryland Young Adults community. Growing together in faith, leadership, and discipleship.">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https:;">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="format-detection" content="telephone=no">
    <title><%= typeof t !== 'undefined' ? t('hero.tag') : 'EUCMD Young Adults' %></title>
    
    <!-- Modern Web Fonts: Noto Sans Ethiopic (for Amharic & Tigrinya) + Plus Jakarta Sans (for English & Afaan Oromoo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Ethiopic:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- GSAP for Smooth Scroll & Animations (with graceful fallback for iOS Safari) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" defer></script>

    <script src="/static/js/vendor/tailwindcss.js"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', '"Noto Sans Ethiopic"', 'system-ui', '-apple-system', 'sans-serif'],
                        ethiopic: ['"Noto Sans Ethiopic"', '"Plus Jakarta Sans"', 'sans-serif']
                    },
                    colors: {
                        brandDark: '#F4F4F5', // zinc-100
                        cardDark: '#FFFFFF',
                        accent: '#000000',
                        accent2: '#52525B', // zinc-600
                        success: '#000000',
                        studio: {
                            900: '#09090b', // zinc-950
                            800: '#18181b', // zinc-900
                            700: '#27272a', // zinc-800
                            100: '#f4f4f5',
                            50: '#fafafa'
                        }
                    },
                    boxShadow: {
                        'premium': '0 20px 40px -10px rgba(0, 0, 0, 0.1)',
                        'premium-dark': '0 20px 40px -10px rgba(0, 0, 0, 0.4)',
                        'glow': '0 0 20px rgba(0, 117, 255, 0.15)'
                    },
                    transitionTimingFunction: {
                        'butter': 'cubic-bezier(0.19, 1, 0.22, 1)'
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            --font-main: 'Plus Jakarta Sans', 'Noto Sans Ethiopic', system-ui, -apple-system, sans-serif;
        }

        html {
            -webkit-text-size-adjust: 100%;
            touch-action: manipulation;
            scroll-behavior: smooth;
        }

        /* Mobile touch & iOS optimizations */
        *, *::before, *::after {
            -webkit-tap-highlight-color: transparent;
        }

        button, a, input, select, textarea {
            touch-action: manipulation;
        }

        /* Prevent iOS Safari from auto-zooming on focus while keeping desktop typography crisp */
        @media screen and (max-width: 768px) {
            input, select, textarea {
                font-size: 16px !important;
            }
        }

        /* Safe area insets for iOS devices (iPhone with notch/dynamic island & home indicator) */
        .ios-safe-top {
            padding-top: max(1.25rem, env(safe-area-inset-top));
        }

        .ios-safe-bottom {
            padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
        }

        /* Touch device active states (replaces mouse-dependent hover) */
        @media (hover: none) and (pointer: coarse) {
            .macos-glass:active,
            .macos-card:active {
                transform: scale(0.99);
                transition: transform 0.15s ease;
            }
            .macos-glass:hover {
                transform: none;
            }
            button:active,
            a:active {
                opacity: 0.85;
            }
        }

        body {
            font-family: var(--font-main);
            margin: 0;
            min-height: 100vh;
            min-height: -webkit-fill-available;
            transition: background-color 0.4s cubic-bezier(0.19, 1, 0.22, 1), color 0.4s cubic-bezier(0.19, 1, 0.22, 1);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            -webkit-overflow-scrolling: touch;
        }

        /* Ethiopic Script Optimization for Amharic and Tigrinya */
        html[lang="am"] body,
        html[lang="ti"] body,
        .font-ethiopic {
            font-family: 'Noto Sans Ethiopic', 'Plus Jakarta Sans', system-ui, sans-serif;
            letter-spacing: normal;
        }
        
        /* Layout Utilities */
        .masonry-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            grid-auto-flow: dense;
        }
        
        .masonry-item-large {
            grid-column: span 2;
            grid-row: span 2;
        }

        @media (max-width: 768px) {
            .masonry-item-large {
                grid-column: span 1;
                grid-row: span 1;
            }
        }

        /* Progressive Enhancement: Elements are ALWAYS visible by default to guarantee instant iPhone loading */
        .gsap-reveal, .gsap-fade-up, .gsap-stagger-item, .gsap-scale-up {
            visibility: visible;
            opacity: 1;
        }
        
        .macos-glass {
            background-color: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 1.5rem;
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.05);
            transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1), box-shadow 0.4s cubic-bezier(0.19, 1, 0.22, 1);
        }
        
        .macos-glass:hover {
            transform: translateY(-4px) scale(1.01);
            box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.1);
        }
        
        .macos-nav {
            background-color: rgba(255, 255, 255, 0.6) !important;
            backdrop-filter: blur(24px) saturate(180%) !important;
            -webkit-backdrop-filter: blur(24px) saturate(180%) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.3) !important;
        }
        
        .macos-card {
            background-color: rgba(255, 255, 255, 0.6) !important;
            backdrop-filter: blur(16px) saturate(180%) !important;
            -webkit-backdrop-filter: blur(16px) saturate(180%) !important;
            border: 1px solid rgba(255, 255, 255, 0.4) !important;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.05) !important;
            border-radius: 1.5rem;
            overflow: hidden;
        }
    
        html.dark body {
            background-color: #09090b; /* Zinc 950 */
            color: #f4f4f5; /* Zinc 100 */
        }
        
        html.dark .macos-glass {
            background-color: rgba(24, 24, 27, 0.5) !important; /* Zinc 900 with opacity */
            backdrop-filter: blur(24px) saturate(180%) !important;
            -webkit-backdrop-filter: blur(24px) saturate(180%) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5);
        }
        
        html.dark .macos-nav {
            background-color: rgba(9, 9, 11, 0.65) !important; /* Zinc 950 */
            backdrop-filter: blur(24px) saturate(180%) !important;
            -webkit-backdrop-filter: blur(24px) saturate(180%) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
        }
        
        html.dark .macos-card {
            background-color: rgba(24, 24, 27, 0.4) !important; /* Zinc 900 */
            backdrop-filter: blur(16px) saturate(180%) !important;
            -webkit-backdrop-filter: blur(16px) saturate(180%) !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5) !important;
        }

        /* Reading Progress Bar */
        #progress-bar {
            position: fixed;
            top: 0;
            left: 0;
            height: 4px;
            background: linear-gradient(to right, #0075ff, #10b981);
            width: 0%;
            z-index: 9999;
            transition: width 0.1s ease;
        }
    </style>
</head>
<body class="bg-studio-50 dark:bg-studio-900 text-zinc-900 dark:text-zinc-100 overflow-x-hidden min-h-screen flex flex-col">
    <div id="progress-bar"></div>

    <!-- Modular Navigation Header (Includes 4-Language Switcher & Theme Toggle) -->
    <%- include('navbar') %>

    <!-- Global i18n Synchronization Engine -->
    <script src="/static/js/i18n-client.js"></script>

