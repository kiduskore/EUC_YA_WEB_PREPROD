    <style>
        :root {
            --font-main: 'Plus Jakarta Sans', 'Noto Sans Ethiopic', system-ui, -apple-system, sans-serif;
        }

        html {
            -webkit-text-size-adjust: 100%;
            touch-action: manipulation;
            scroll-behavior: smooth;
        }

        /* Mobile touch & iOS optimizations */
        *, *::before, *::after {
            -webkit-tap-highlight-color: transparent;
        }

        button, a, input, select, textarea {
            touch-action: manipulation;
        }

        /* Prevent iOS Safari from auto-zooming on focus while keeping desktop typography crisp */
        @media screen and (max-width: 768px) {
            input, select, textarea {
                font-size: 16px !important;
            }
        }

        /* Safe area insets for iOS devices (iPhone with notch/dynamic island & home indicator) */
        .ios-safe-top {
            padding-top: max(1.25rem, env(safe-area-inset-top));
        }

        .ios-safe-bottom {
            padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
        }

        /* Touch device active states (replaces mouse-dependent hover) */
        @media (hover: none) and (pointer: coarse) {
            .macos-glass:active,
            .macos-card:active {
                transform: scale(0.99);
                transition: transform 0.15s ease;
            }
            .macos-glass:hover {
                transform: none;
            }
            button:active,
            a:active {
                opacity: 0.85;
            }
        }

        body {
            font-family: var(--font-main);
            margin: 0;
            min-height: 100vh;
            min-height: -webkit-fill-available;
            transition: background-color 0.4s cubic-bezier(0.19, 1, 0.22, 1), color 0.4s cubic-bezier(0.19, 1, 0.22, 1);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            -webkit-overflow-scrolling: touch;
        }

        /* Ethiopic Script Optimization for Amharic and Tigrinya */
        html[lang="am"] body,
        html[lang="ti"] body,
        .font-ethiopic {
            font-family: 'Noto Sans Ethiopic', 'Plus Jakarta Sans', system-ui, sans-serif;
            letter-spacing: normal;
        }
        
        /* Layout Utilities */
        .masonry-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            grid-auto-flow: dense;
        }
        
        .masonry-item-large {
            grid-column: span 2;
            grid-row: span 2;
        }

        @media (max-width: 768px) {
            .masonry-item-large {
                grid-column: span 1;
                grid-row: span 1;
            }
        }

        /* Progressive Enhancement: Elements are ALWAYS visible by default to guarantee instant iPhone loading */
        .gsap-reveal, .gsap-fade-up, .gsap-stagger-item, .gsap-scale-up {
            visibility: visible;
            opacity: 1;
        }
        
        .macos-glass {
            background-color: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 1.5rem;
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.05);
            transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1), box-shadow 0.4s cubic-bezier(0.19, 1, 0.22, 1);
        }
        
        .macos-glass:hover {
            transform: translateY(-4px) scale(1.01);
            box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.1);
        }
        
        .macos-nav {
            background-color: rgba(255, 255, 255, 0.8) !important;
            backdrop-filter: blur(24px) saturate(180%) !important;
            -webkit-backdrop-filter: blur(24px) saturate(180%) !important;
            border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;
        }

        html.dark .macos-nav {
            background-color: rgba(21, 18, 14, 0.85) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
        }
        
        .macos-card {
            background-color: #ffffff;
            border: 1px solid rgba(0, 0, 0, 0.08);
            box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
            border-radius: 1.5rem;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        html.dark .macos-card {
            background-color: #1F1B16 !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6) !important;
        }

        html.dark .macos-glass {
            background-color: rgba(31, 27, 22, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.6);
        }
    
        html.dark body {
            background-color: #14110C; /* Rich dark stone */
            color: #F4EFE6; /* Warm stone text */
        }
        
        .editorial-rule {
            height: 1px;
            background-color: #E8E1D5;
        }
        html.dark .editorial-rule {
            background-color: #2E2820;
        }
        
        /* Reading Progress Bar */
        #progress-bar {
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            background: linear-gradient(to right, #9E6738, #B65C2B);
            width: 0%;
            z-index: 9999;
            transition: width 0.1s ease;
        }
    </style>
</head>
