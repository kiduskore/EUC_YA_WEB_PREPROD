<div id="ai-chat-widget" class="fixed bottom-6 right-6 z-50 font-sans">
    <!-- Chat Button -->
    <button id="ai-chat-btn" class="w-14 h-14 bg-blue-600 hover:bg-blue-700 text-white rounded-full flex items-center justify-center shadow-2xl transition-transform hover:scale-110 active:scale-95 focus:outline-none focus:ring-4 focus:ring-blue-500/30 group">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 transition-transform group-hover:rotate-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
        </svg>
    </button>

    <!-- Chat Window -->
    <div id="ai-chat-window" class="hidden absolute bottom-20 right-0 w-[350px] sm:w-[400px] h-[550px] max-h-[80vh] bg-white dark:bg-studio-800 rounded-2xl shadow-2xl border border-zinc-200 dark:border-white/10 flex-col overflow-hidden transition-all origin-bottom-right">
        <!-- Header -->
        <div class="bg-blue-600 p-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center backdrop-blur-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-white font-bold text-sm">EUCMD Assistant</h3>
                    <p class="text-blue-100 text-xs">Powered by Gemini</p>
                </div>
            </div>
            <button id="ai-chat-close" class="text-blue-100 hover:text-white transition-colors focus:outline-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Messages Area -->
        <div id="ai-chat-messages" class="flex-1 p-4 overflow-y-auto bg-zinc-50 dark:bg-studio-900/50 space-y-4">
            <!-- Greeting Message -->
            <div class="flex flex-col items-start max-w-[85%]">
                <div class="bg-white dark:bg-studio-800 text-zinc-800 dark:text-zinc-200 p-3 rounded-2xl rounded-tl-sm shadow-sm text-sm leading-relaxed border border-zinc-100 dark:border-white/5">
                    Hi there! 👋 I'm the EUCMD Young Adults assistant. Ask me anything about our community, discipleship pillars, or how to get involved!
                </div>
            </div>
        </div>

        <!-- Input Area -->
        <div class="p-4 bg-white dark:bg-studio-800 border-t border-zinc-100 dark:border-white/10">
            <form id="ai-chat-form" class="flex items-center gap-2 relative">
                <input type="text" id="ai-chat-input" placeholder="Ask a question..." class="w-full bg-zinc-100 dark:bg-studio-900/50 text-zinc-900 dark:text-white rounded-full pl-4 pr-12 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/50 border border-transparent focus:border-blue-500/30 transition-all placeholder:text-zinc-500 dark:placeholder:text-zinc-500" autocomplete="off" required>
                <button type="submit" id="ai-chat-submit" class="absolute right-1.5 w-9 h-9 bg-blue-600 hover:bg-blue-700 text-white rounded-full flex items-center justify-center transition-transform hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-0.5" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
                    </svg>
                </button>
            </form>
            <div class="mt-2 text-center">
                <span class="text-[10px] text-zinc-400 dark:text-zinc-600">AI can make mistakes. Verify important info.</span>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<style>
    /* Render markdown nicely */
    .prose-ai p { margin-bottom: 0.5em; }
    .prose-ai p:last-child { margin-bottom: 0; }
    .prose-ai strong { font-weight: 700; }
    .prose-ai ul { list-style-type: disc; padding-left: 1.25em; margin-bottom: 0.5em; }
    .prose-ai ol { list-style-type: decimal; padding-left: 1.25em; margin-bottom: 0.5em; }
    .prose-ai a { text-decoration: underline; }
    
    #ai-chat-window.show {
        display: flex;
        animation: chatSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    @keyframes chatSlideUp {
        from { opacity: 0; transform: translateY(20px) scale(0.95); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
    
    .typing-indicator span {
        display: inline-block;
        width: 4px;
        height: 4px;
        background-color: currentColor;
        border-radius: 50%;
        animation: typing 1.4s infinite ease-in-out both;
        margin: 0 1px;
    }
    
    .typing-indicator span:nth-child(1) { animation-delay: -0.32s; }
    .typing-indicator span:nth-child(2) { animation-delay: -0.16s; }
    
    @keyframes typing {
        0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
        40% { transform: scale(1); opacity: 1; }
    }
</style>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const chatBtn = document.getElementById('ai-chat-btn');
    const chatWindow = document.getElementById('ai-chat-window');
    const closeBtn = document.getElementById('ai-chat-close');
    const form = document.getElementById('ai-chat-form');
    const input = document.getElementById('ai-chat-input');
    const messagesArea = document.getElementById('ai-chat-messages');
    const submitBtn = document.getElementById('ai-chat-submit');

    // Make sure marked acts securely
    if (typeof marked !== 'undefined' && marked.setOptions) {
        try {
            marked.setOptions({
                headerIds: false,
                mangle: false,
                breaks: true
            });
        } catch (e) {}
    }

    let isOpen = false;

    const toggleChat = () => {
        isOpen = !isOpen;
        if (isOpen) {
            chatWindow.classList.remove('hidden');
            chatWindow.classList.add('show');
            setTimeout(() => input.focus(), 100);
        } else {
            chatWindow.classList.remove('show');
            chatWindow.classList.add('hidden');
        }
    };

    chatBtn.addEventListener('click', toggleChat);
    closeBtn.addEventListener('click', toggleChat);

    // Close on click outside
    document.addEventListener('click', (e) => {
        if (isOpen && !chatWindow.contains(e.target) && !chatBtn.contains(e.target)) {
            toggleChat();
        }
    });

    const appendMessage = (content, isUser = false) => {
        const wrapper = document.createElement('div');
        wrapper.className = `flex flex-col items-${isUser ? 'end' : 'start'} max-w-[85%] ${isUser ? 'ml-auto' : ''}`;
        
        const bubble = document.createElement('div');
        
        if (isUser) {
            bubble.className = 'bg-blue-600 text-white p-3 rounded-2xl rounded-tr-sm shadow-sm text-sm leading-relaxed';
            bubble.textContent = content;
        } else {
            bubble.className = 'bg-white dark:bg-studio-800 text-zinc-800 dark:text-zinc-200 p-3 rounded-2xl rounded-tl-sm shadow-sm text-sm leading-relaxed border border-zinc-100 dark:border-white/5 prose-ai';
            if (typeof marked !== 'undefined') {
                bubble.innerHTML = marked.parse(content, { breaks: true });
            } else {
                bubble.textContent = content;
            }
        }
        
        wrapper.appendChild(bubble);
        messagesArea.appendChild(wrapper);
        messagesArea.scrollTop = messagesArea.scrollHeight;
        return wrapper;
    };

    const showTyping = () => {
        const wrapper = document.createElement('div');
        wrapper.id = 'ai-typing-indicator';
        wrapper.className = `flex flex-col items-start max-w-[85%]`;
        
        const bubble = document.createElement('div');
        bubble.className = 'bg-white dark:bg-studio-800 text-zinc-500 p-4 rounded-2xl rounded-tl-sm shadow-sm border border-zinc-100 dark:border-white/5 flex items-center justify-center min-w-[50px]';
        
        bubble.innerHTML = '<div class="typing-indicator"><span></span><span></span><span></span></div>';
        
        wrapper.appendChild(bubble);
        messagesArea.appendChild(wrapper);
        messagesArea.scrollTop = messagesArea.scrollHeight;
        return wrapper;
    };

    const removeTyping = () => {
        const indicator = document.getElementById('ai-typing-indicator');
        if (indicator) indicator.remove();
    };

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const text = input.value.trim();
        if (!text) return;

        // Add user msg
        appendMessage(text, true);
        input.value = '';
        submitBtn.disabled = true;

        showTyping();

        try {
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
            const res = await fetch('/api/chat', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'x-csrf-token': csrfToken
                },
                body: JSON.stringify({ message: text })
            });

            removeTyping();
            
            if (!res.ok) {
                const data = await res.json().catch(() => ({}));
                appendMessage(data.error || 'Oops, something went wrong. Please try again.');
            } else {
                const data = await res.json();
                appendMessage(data.text);
            }
        } catch (err) {
            removeTyping();
            appendMessage('Network error. Please check your connection and try again.');
        } finally {
            submitBtn.disabled = false;
            input.focus();
        }
    });
});
</script>
