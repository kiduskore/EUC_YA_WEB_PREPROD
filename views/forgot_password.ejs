<%- include('partials/header') %>
<div class="min-h-screen flex items-center justify-center p-4 relative overflow-hidden bg-[#0b1437] text-white">
    <div class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-[#0075ff] rounded-full mix-blend-screen filter blur-[100px] opacity-20"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-96 h-96 bg-[#01b574] rounded-full mix-blend-screen filter blur-[100px] opacity-20"></div>

    <div class="w-full max-w-md p-8 relative z-10 text-center" style="background: #111c44; border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 1.25rem; box-shadow: 0 4px 24px rgba(0,0,0,0.2);">
        <div class="flex justify-center mb-6">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-[#0075ff] to-[#01b574] flex items-center justify-center shadow-[0_0_30px_rgba(0,117,255,0.4)]">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
            </div>
        </div>
        
        <h2 class="text-2xl font-bold mb-2">Forgot Password</h2>
        <p class="text-gray-400 text-sm mb-8">Enter your email and we'll send you a reset link.</p>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-500/10 border border-red-500/50 text-red-400 rounded-xl p-3 text-sm mb-6">
            <%= error %>
        </div>
        <% } %>
        
        <% if (typeof success !== 'undefined' && success) { %>
        <div class="bg-green-500/10 border border-green-500/50 text-green-400 rounded-xl p-3 text-sm mb-6 text-left">
            <%= success %>
            <% if (typeof resetLink !== 'undefined' && resetLink) { %>
                <div class="mt-3 p-3 bg-black/30 rounded border border-white/5 text-xs">
                    <span class="text-gray-400 block mb-1">Demo Environment Link:</span>
                    <a href="<%= resetLink %>" class="text-[#0075ff] hover:underline break-all"><%= resetLink %></a>
                </div>
            <% } %>
        </div>
        <div class="mt-6">
            <a href="/login" class="text-[#0075ff] font-bold text-sm hover:text-white transition-colors">Return to Sign In</a>
        </div>
        <% } else { %>
            <form method="POST" action="/forgot-password" class="space-y-4 text-left">
                <div>
                    <label class="block text-xs font-semibold text-gray-400 mb-1">Email Address</label>
                    <input type="email" name="email" required autocapitalize="none" autocorrect="off" autocomplete="email" placeholder="leader@euc.org" class="w-full bg-slate-800/60 border border-white/10 text-white rounded-xl p-4 outline-none focus:border-[#0075ff] transition-all">
                </div>
                
                <button type="submit" class="w-full bg-white text-gray-900 font-bold rounded-xl p-4 mt-4 transition-transform hover:scale-[1.02] active:scale-[0.98]">
                    Send Reset Link
                </button>
            </form>
            
            <div class="mt-6 text-sm text-gray-400">
                Remember your password? <a href="/login" class="text-[#0075ff] hover:text-white transition-colors font-semibold">Sign In</a>
            </div>
        <% } %>
    </div>
</div>
<%- include('partials/footer') %>
