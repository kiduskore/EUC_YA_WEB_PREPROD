<%- include('partials/header') %>

<main id="main-content" class="flex-grow pt-28 pb-20 px-6 lg:px-12 max-w-xl mx-auto text-center">
    <div class="p-8 sm:p-12 rounded-3xl bg-white dark:bg-studio-800 border border-zinc-200 dark:border-white/10 shadow-xl space-y-6">
        
        <div class="w-16 h-16 rounded-2xl bg-blue-500/10 text-blue-600 dark:text-blue-400 mx-auto flex items-center justify-center font-bold text-2xl">
            ✉️
        </div>

        <h1 class="text-2xl sm:text-3xl font-black text-studio-900 dark:text-white tracking-tight">
            Email Subscription Preferences
        </h1>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-800 dark:text-emerald-300 text-sm font-semibold space-y-1">
                <p>✓ You have been successfully unsubscribed.</p>
                <p class="text-xs font-normal text-zinc-600 dark:text-zinc-400">
                    <%= email %> will no longer receive weekly devotionals or gathering announcements.
                </p>
            </div>
            <div class="pt-4">
                <a href="/" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 font-bold text-xs shadow-md">
                    Return to Homepage
                </a>
            </div>
        <% } else { %>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                We are sorry to see you go! Enter or confirm your email address below to unsubscribe with one click.
            </p>

            <form method="POST" action="/unsubscribe" class="space-y-4 text-left">
                <input type="hidden" name="csrf_token" value="<%= typeof csrf_token !== 'undefined' ? csrf_token : '' %>">
                <div>
                    <label for="unsub-email" class="block text-xs font-bold uppercase tracking-wider text-zinc-700 dark:text-zinc-300 mb-1.5">
                        Email Address
                    </label>
                    <input type="email" 
                           name="email" 
                           id="unsub-email" 
                           required 
                           value="<%= typeof email !== 'undefined' ? email : '' %>" 
                           placeholder="name@example.com"
                           class="w-full px-4 py-3 rounded-xl bg-zinc-50 dark:bg-studio-900/60 border border-zinc-300 dark:border-white/10 text-sm text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-xs font-semibold">
                        <%= error %>
                    </div>
                <% } %>

                <button type="submit" class="w-full py-3.5 rounded-xl bg-zinc-900 hover:bg-black dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200 text-white font-bold text-sm shadow-md transition-all active:scale-[0.98]">
                    Confirm 1-Click Unsubscribe
                </button>
            </form>
        <% } %>

        <div class="border-t border-zinc-200 dark:border-white/10 pt-4 text-xs text-zinc-500 dark:text-zinc-400">
            <p>Emmanuel United Church of Maryland &bull; 914 Silver Spring Ave, Silver Spring, MD 20910</p>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
