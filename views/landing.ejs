    <script>
        function openReviveNotifyModal() {
            const modal = document.getElementById('revive-modal');
            const box = document.getElementById('revive-modal-box');
            modal.style.display = 'flex';
            requestAnimationFrame(() => {
                modal.classList.remove('opacity-0', 'pointer-events-none');
                modal.classList.add('opacity-100');
                box.classList.remove('scale-95');
                box.classList.add('scale-100');
            });
        }

        function closeReviveNotifyModal() {
            const modal = document.getElementById('revive-modal');
            const box = document.getElementById('revive-modal-box');
            modal.classList.remove('opacity-100');
            modal.classList.add('opacity-0', 'pointer-events-none');
            box.classList.remove('scale-100');
            box.classList.add('scale-95');
            setTimeout(() => {
                modal.style.display = 'none';
            }, 300);
        }

        async function submitReviveNotify(e) {
            e.preventDefault();
            const btn = document.getElementById('revive-submit-btn');
            const form = document.getElementById('revive-notify-form');
            const success = document.getElementById('revive-success-msg');
            const name = document.getElementById('revive-name').value.trim();
            const email = document.getElementById('revive-email').value.trim();
            const phone = document.getElementById('revive-phone').value.trim();

            btn.disabled = true;
            btn.innerText = 'Saving...';

            try {
                const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
                const res = await fetch('/api/pipeline', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrf
                    },
                    body: JSON.stringify({
                        name: name,
                        email: email,
                        phone: phone || '',
                        stage: 'first_contact',
                        notes: 'Knowing God (Isaiah 40:28) - Coming Soon Event Waitlist'
                    })
                });

                if (res.ok) {
                    form.classList.add('hidden');
                    success.classList.remove('hidden');
                } else {
                    alert('Thank you! Your interest has been recorded.');
                    closeReviveNotifyModal();
                }
            } catch (err) {
                console.error(err);
                form.classList.add('hidden');
                success.classList.remove('hidden');
            }
        }

        function downloadReviveCalendar() {
            const icsData = [
                'BEGIN:VCALENDAR',
                'VERSION:2.0',
                'PRODID:-//EUCMD Young Adults//Knowing God//EN',
                'BEGIN:VEVENT',
                'SUMMARY:Knowing God! (Isaiah 40:28) - EUCMD Young Adults',
                'DESCRIPTION:Do you not know? Have you not heard? The Lord is the everlasting God\\, the Creator of the ends of the earth. He will not grow tired or weary\\, and His understanding no one can fathom. (Isaiah 40:28). Join EUCMD Young Adults for our upcoming Knowing God gathering.',
                'LOCATION:Maryland & DMV Region',
                'STATUS:CONFIRMED',
                'END:VEVENT',
                'END:VCALENDAR'
            ].join('\\r\\n');

            const blob = new Blob([icsData], { type: 'text/calendar;charset=utf-8' });
            const link = document.createElement('a');
            link.href = window.URL.createObjectURL(blob);
            link.setAttribute('download', 'knowing-god-isaiah-40-28.ics');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            showReviveToast('Calendar reminder saved! Check your downloads.');
        }

        function shareReviveEvent() {
            const shareUrl = window.location.origin + '/#coming-soon-event';
            const shareTitle = 'Knowing God! (Isaiah 40:28) — EUCMD Young Adults';
            const shareText = '“Do you not know? Have you not heard? The Lord is the everlasting God, the Creator of the ends of the earth. He will not grow tired or weary, and His understanding no one can fathom.” Check out the upcoming Young Adults gathering: Knowing God (Isaiah 40:28)';

            if (navigator.share) {
                navigator.share({
                    title: shareTitle,
                    text: shareText,
                    url: shareUrl
                }).catch(() => {});
            } else {
                navigator.clipboard.writeText(shareUrl).then(() => {
                    showReviveToast('Event link copied to clipboard! Share it with friends.');
                }).catch(() => {
                    showReviveToast('Share link: ' + shareUrl);
                });
            }
        }

        function showReviveToast(msg) {
            const toast = document.getElementById('revive-toast');
            const text = document.getElementById('revive-toast-text');
            text.innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
            toast.classList.add('translate-y-0', 'opacity-100');
            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
            }, 3500);
        }
    </script>
