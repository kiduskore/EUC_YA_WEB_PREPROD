<%- include('partials/header') %>
<!-- Hero Section -->
    <header class="relative min-h-screen flex items-end justify-start pt-20 pb-24 overflow-hidden">
        <!-- Hero Background Slideshow -->
        <div class="absolute inset-0">
            <div class="hero-slide" style="background-image: url('/static/hero_images/new_hero.jpg'); animation-delay: 0s;"></div>
            <div class="hero-slide" style="background-image: url('/static/hero_images/worship_crowd.jpg'); animation-delay: 5s;"></div>
            <div class="hero-slide" style="background-image: url('/static/hero_images/dark_worship.jpg'); animation-delay: 10s;"></div>
            <div class="hero-slide" style="background-image: url('/static/hero_images/crowd_praying.jpg'); animation-delay: 15s;"></div>
        </div>
        
        <!-- Premium Gradient Overlay (Darker at bottom for text contrast) -->
        <div class="absolute inset-0 bg-gradient-to-t from-studio-900 via-studio-900/60 to-transparent"></div>

        <style>
            .hero-slide {
                position: absolute;
                inset: 0;
                background-size: cover;
                background-position: center;
                opacity: 0;
                animation: heroFade 20s infinite;
            }
            @keyframes heroFade {
                0%   { opacity: 0; transform: scale(1); }
                5%   { opacity: 1; }
                25%  { opacity: 1; transform: scale(1.05); }
                30%  { opacity: 0; transform: scale(1.08); }
                100% { opacity: 0; transform: scale(1.1); }
            }
        </style>
        
        <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-12">
            <div class="max-w-4xl gsap-stagger-container">
                <div class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full border border-white/10 bg-white/5 backdrop-blur-md mb-8 gsap-stagger-item shadow-2xl">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-white text-xs tracking-[0.2em] font-bold uppercase"><%= typeof t !== 'undefined' ? t('hero.tag') : 'EUCMD Young Adults' %></span>
                </div>

                <h1 class="text-white text-5xl md:text-7xl lg:text-[7.5rem] font-black tracking-tighter leading-[0.95] mb-8 gsap-stagger-item drop-shadow-2xl">
                    <%= typeof t !== 'undefined' ? t('hero.titleLine1') : 'Growing Deep.' %><br/>
                    <span class="text-white/60">
                        <%= typeof t !== 'undefined' ? t('hero.titleLine2') : 'Reaching Wide.' %>
                    </span>
                </h1>

                <p class="text-zinc-200 text-lg md:text-2xl max-w-2xl font-medium leading-relaxed mb-12 gsap-stagger-item drop-shadow-lg">
                    <%= typeof t !== 'undefined' ? t('hero.subtitle') : 'We are a community of young adults in Maryland passionate about encountering Jesus, equipping believers, and empowering disciples.' %>
                </p>

                <div class="flex flex-col sm:flex-row gap-4 items-center gsap-stagger-item">
                    <a href="#join" class="w-full sm:w-auto px-10 py-4 min-h-[56px] flex items-center justify-center bg-white text-studio-900 font-bold rounded-full hover:bg-zinc-100 active:bg-zinc-200 transition-all text-center text-sm tracking-wide touch-manipulation active:scale-[0.98] shadow-xl">
                        <%= typeof t !== 'undefined' ? t('hero.joinGroup') : 'Join a Small Group' %>
                    </a>
                    <a href="#resources" class="w-full sm:w-auto px-10 py-4 min-h-[56px] flex items-center justify-center bg-transparent border-2 border-white/20 text-white hover:bg-white/10 active:bg-white/20 transition-all rounded-full text-center text-sm font-bold tracking-wide backdrop-blur-md touch-manipulation active:scale-[0.98]">
                        <%= typeof t !== 'undefined' ? t('hero.freeResources') : 'Explore Resources' %>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Four Discipleship Pillars Section - Asymmetric Masonry -->
    <section class="py-24 bg-studio-50 dark:bg-studio-900 relative overflow-hidden">
        <!-- Glassmorphism Background Blobs -->
        <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
            <div class="absolute -top-[10%] -left-[10%] w-[40%] h-[40%] rounded-full bg-blue-500/20 dark:bg-blue-600/20 blur-[120px] mix-blend-multiply dark:mix-blend-screen opacity-70 animate-pulse"></div>
            <div class="absolute top-[20%] -right-[10%] w-[35%] h-[35%] rounded-full bg-purple-500/20 dark:bg-purple-600/20 blur-[120px] mix-blend-multiply dark:mix-blend-screen opacity-70" style="animation: pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite;"></div>
            <div class="absolute -bottom-[10%] left-[20%] w-[40%] h-[40%] rounded-full bg-emerald-500/20 dark:bg-emerald-600/20 blur-[120px] mix-blend-multiply dark:mix-blend-screen opacity-70" style="animation: pulse 10s cubic-bezier(0.4, 0, 0.6, 1) infinite;"></div>
        </div>
        <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
            
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-20 gsap-fade-up">
                <div class="max-w-2xl">
                    <span class="text-accent2 dark:text-zinc-400 font-bold tracking-[0.15em] uppercase text-xs mb-4 block">
                        <%= typeof t !== 'undefined' ? t('pillars.tag') : 'Discipleship Journey' %>
                    </span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-studio-900 dark:text-white leading-tight">
                        <%= typeof t !== 'undefined' ? t('pillars.title') : 'Four Pillars of Our Community' %>
                    </h2>
                </div>
                <p class="text-zinc-600 dark:text-zinc-400 max-w-md text-lg leading-relaxed md:pb-2">
                    <%= typeof t !== 'undefined' ? t('pillars.subtitle') : 'A structured, Spirit-led pathway designed to help every young adult mature into an active disciple of Jesus Christ.' %>
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 gsap-stagger-container">
                <!-- Pillar 1: Foundation (Large Masonry Block) -->
                <div class="macos-card p-8 flex flex-col justify-between group gsap-stagger-item dark:bg-studio-800 border-zinc-200 dark:border-white/5 hover:border-blue-500/30 hover:shadow-xl transition-all duration-300 relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-purple-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    <div class="relative z-10">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-2xl font-bold tracking-tight text-studio-900 dark:text-white"><%= typeof t !== 'undefined' ? t('pillars.foundation.title') : 'Foundation' %></h3>
                            <span class="text-3xl font-black text-zinc-100 dark:text-zinc-800/80 group-hover:text-blue-500/20 transition-colors">01</span>
                        </div>
                        <p class="text-zinc-600 dark:text-zinc-400 mb-8 leading-relaxed">
                            <%= typeof t !== 'undefined' ? t('pillars.foundation.desc') : 'Rooted in Christ through genuine salvation, baptism in water, and understanding the Kingdom of God.' %>
                        </p>
                    </div>
                    <div class="relative z-10 flex flex-col space-y-3 border-t border-zinc-100 dark:border-white/10 pt-6 mt-auto">
                        <a href="/salvation<%= typeof langQuery !== 'undefined' ? langQuery : '' %>" class="group/link text-sm font-semibold text-zinc-900 dark:text-zinc-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-2 touch-manipulation"><span class="text-blue-500/50 group-hover/link:text-blue-500 transition-colors">→</span> <%= typeof t !== 'undefined' ? t('nav.foundation.salvation') : 'Salvation' %></a>
                        <a href="/water-baptism<%= typeof langQuery !== 'undefined' ? langQuery : '' %>" class="group/link text-sm font-semibold text-zinc-900 dark:text-zinc-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-2 touch-manipulation"><span class="text-blue-500/50 group-hover/link:text-blue-500 transition-colors">→</span> <%= typeof t !== 'undefined' ? t('nav.foundation.waterBaptism') : 'Water Baptism' %></a>
                        <a href="/kingdom<%= typeof langQuery !== 'undefined' ? langQuery : '' %>" class="group/link text-sm font-semibold text-zinc-900 dark:text-zinc-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-2 touch-manipulation"><span class="text-blue-500/50 group-hover/link:text-blue-500 transition-colors">→</span> <%= typeof t !== 'undefined' ? t('nav.foundation.kingdom') : 'Kingdom' %></a>
                    </div>
                </div>

                <!-- Pillar 2: Belong -->
                <div class="macos-card p-8 flex flex-col justify-between group gsap-stagger-item dark:bg-studio-800 border-zinc-200 dark:border-white/5 hover:border-purple-500/30 hover:shadow-xl transition-all duration-300">
                    <div>
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-2xl font-bold tracking-tight text-studio-900 dark:text-white"><%= typeof t !== 'undefined' ? t('pillars.belong.title') : 'Belong' %></h3>
                            <span class="text-3xl font-black text-zinc-100 dark:text-zinc-800/80 group-hover:text-purple-500/20 transition-colors">02</span>
                        </div>
                        <p class="text-zinc-600 dark:text-zinc-400 mb-8 leading-relaxed">
                            <%= typeof t !== 'undefined' ? t('pillars.belong.desc') : 'Living in covenant fellowship through local church membership, lifegroups, and generational mentorship.' %>
                        </p>
                    </div>
                    <div class="flex flex-col space-y-3 pt-6 mt-auto border-t border-zinc-100 dark:border-white/10">
                        <a href="/membership<%= typeof langQuery !== 'undefined' ? langQuery : '' %>" class="group/link text-sm font-semibold text-zinc-900 dark:text-zinc-300 hover:text-purple-600 dark:hover:text-purple-400 transition-colors inline-flex items-center gap-2 touch-manipulation"><span class="text-purple-500/50 group-hover/link:text-purple-500 transition-colors">→</span> <%= typeof t !== 'undefined' ? t('nav.belong.membership') : 'Membership' %></a>
                        <a href="/community<%= typeof langQuery !== 'undefined' ? langQuery : '' %>" class="group/link text-sm font-semibold text-zinc-900 dark:text-zinc-300 hover:text-purple-600 dark:hover:text-purple-400 transition-colors inline-flex items-center gap-2 touch-manipulation"><span class="text-purple-500/50 group-hover/link:text-purple-500 transition-colors">→</span> <%= typeof t !== 'undefined' ? t('nav.belong.community') : 'Community' %></a>
                        <a href="/mentorship<%= typeof langQuery !== 'undefined' ? langQuery : '' %>" class="group/link text-sm font-semibold text-zinc-900 dark:text-zinc-300 hover:text-purple-600 dark:hover:text-purple-400 transition-colors inline-flex items-center gap-2 touch-manipulation"><span class="text-purple-500/50 group-hover/link:text-purple-500 transition-colors">→</span> <%= typeof t !== 'undefined' ? t('nav.belong.mentorship') : 'Mentorship' %></a>
                    </div>
                </div>

                <!-- Pillar 3: Formation -->
                <div class="macos-card p-8 flex flex-col justify-between group gsap-stagger-item dark:bg-studio-800 border-zinc-200 dark:border-white/5 hover:border-emerald-500/30 hover:shadow-xl transition-all duration-300">
                    <div>
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-2xl font-bold tracking-tight text-studio-900 dark:text-white"><%= typeof t !== 'undefined' ? t('pillars.formation.title') : 'Formation' %></h3>
                            <span class="text-3xl font-black text-zinc-100 dark:text-zinc-800/80 group-hover:text-emerald-500/20 transition-colors">03</span>
                        </div>
                        <p class="text-zinc-600 dark:text-zinc-400 mb-8 leading-relaxed">
                            <%= typeof t !== 'undefined' ? t('pillars.formation.desc') : 'Transformed by scripture memorization, personal spiritual disciplines, emotional maturity, and availability to God.' %>
                        </p>
                    </div>
                    <div class="flex flex-col space-y-3 pt-6 mt-auto border-t border-zinc-100 dark:border-white/10">
                        <a href="/scripture-memory<%= typeof langQuery !== 'undefined' ? langQuery : '' %>" class="group/link text-sm font-semibold text-zinc-900 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-2 touch-manipulation"><span class="text-emerald-500/50 group-hover/link:text-emerald-500 transition-colors">→</span> <%= typeof t !== 'undefined' ? t('nav.formation.scriptureMemory') : 'Scripture Memory' %></a>
                        <a href="/growth<%= typeof langQuery !== 'undefined' ? langQuery : '' %>" class="group/link text-sm font-semibold text-zinc-900 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-2 touch-manipulation"><span class="text-emerald-500/50 group-hover/link:text-emerald-500 transition-colors">→</span> <%= typeof t !== 'undefined' ? t('nav.formation.growth') : 'Growth' %></a>
                        <a href="/maturity<%= typeof langQuery !== 'undefined' ? langQuery : '' %>" class="group/link text-sm font-semibold text-zinc-900 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-2 touch-manipulation"><span class="text-emerald-500/50 group-hover/link:text-emerald-500 transition-colors">→</span> <%= typeof t !== 'undefined' ? t('nav.formation.maturity') : 'Maturity' %></a>
                    </div>
                </div>

                <!-- Pillar 4: Mission (Spans rows if needed) -->
                <div class="macos-card p-8 flex flex-col justify-between group gsap-stagger-item dark:bg-studio-800 border-zinc-200 dark:border-white/5 hover:border-amber-500/30 hover:shadow-xl transition-all duration-300">
                    <div>
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-2xl font-bold tracking-tight text-studio-900 dark:text-white"><%= typeof t !== 'undefined' ? t('pillars.mission.title') : 'Mission' %></h3>
                            <span class="text-3xl font-black text-zinc-100 dark:text-zinc-800/80 group-hover:text-amber-500/20 transition-colors">04</span>
                        </div>
                        <p class="text-zinc-600 dark:text-zinc-400 mb-8 leading-relaxed">
                            <%= typeof t !== 'undefined' ? t('pillars.mission.desc') : 'Mobilized for global impact through faithful local serving, evangelism, and radical kingdom generosity.' %>
                        </p>
                    </div>
                    <div class="flex flex-col space-y-3 pt-6 mt-auto border-t border-zinc-100 dark:border-white/10">
                        <a href="/serving<%= typeof langQuery !== 'undefined' ? langQuery : '' %>" class="group/link text-sm font-semibold text-zinc-900 dark:text-zinc-300 hover:text-amber-600 dark:hover:text-amber-400 transition-colors inline-flex items-center gap-2 touch-manipulation"><span class="text-amber-500/50 group-hover/link:text-amber-500 transition-colors">→</span> <%= typeof t !== 'undefined' ? t('nav.mission.serving') : 'Serving' %></a>
                        <a href="/generosity<%= typeof langQuery !== 'undefined' ? langQuery : '' %>" class="group/link text-sm font-semibold text-zinc-900 dark:text-zinc-300 hover:text-amber-600 dark:hover:text-amber-400 transition-colors inline-flex items-center gap-2 touch-manipulation"><span class="text-amber-500/50 group-hover/link:text-amber-500 transition-colors">→</span> <%= typeof t !== 'undefined' ? t('nav.mission.generosity') : 'Generosity' %></a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Resources Section -->
    <section id="resources" class="py-24 bg-zinc-100 dark:bg-studio-900 border-t border-zinc-200 dark:border-white/5 relative overflow-hidden">
        <!-- Glassmorphism Background Blobs -->
        <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
            <div class="absolute top-[30%] -left-[15%] w-[50%] h-[50%] rounded-full bg-indigo-500/20 dark:bg-indigo-600/20 blur-[120px] mix-blend-multiply dark:mix-blend-screen opacity-70 animate-pulse"></div>
            <div class="absolute -bottom-[20%] right-[10%] w-[40%] h-[40%] rounded-full bg-blue-500/20 dark:bg-blue-600/20 blur-[120px] mix-blend-multiply dark:mix-blend-screen opacity-70" style="animation: pulse 9s cubic-bezier(0.4, 0, 0.6, 1) infinite;"></div>
        </div>
        <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
            <div class="text-center mb-16 gsap-fade-up">
                <span class="text-accent2 dark:text-zinc-400 font-bold tracking-[0.15em] uppercase text-xs mb-4 block">
                    <%= typeof t !== 'undefined' ? t('resources.tag') : 'Equip & Grow' %>
                </span>
                <h2 class="text-4xl md:text-5xl font-black tracking-tight text-studio-900 dark:text-white mb-6">
                    <%= typeof t !== 'undefined' ? t('resources.title') : 'Discipleship Resources' %>
                </h2>
                <p class="text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto text-lg leading-relaxed">
                    <%= typeof t !== 'undefined' ? t('resources.subtitle') : 'Access our curated library of study guides, books, and tools to help you grow deeper in your walk with Christ.' %>
                </p>
            </div>

            <div id="public-resources" class="flex flex-wrap gap-6 lg:gap-8 gsap-stagger-container">
                <div class="text-center py-12 text-zinc-400 dark:text-zinc-500 col-span-full animate-pulse text-sm font-semibold tracking-wide">
                    <%= typeof t !== 'undefined' ? t('resources.loading') : 'Loading resources...' %>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Next Steps Section -->
    <section class="py-24 bg-white dark:bg-studio-800 relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-zinc-200 dark:via-white/10 to-transparent"></div>
        
        <!-- Glassmorphism Background Blobs -->
        <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
            <div class="absolute -top-[10%] left-[20%] w-[35%] h-[35%] rounded-full bg-pink-500/10 dark:bg-pink-600/10 blur-[120px] mix-blend-multiply dark:mix-blend-screen opacity-70 animate-pulse"></div>
            <div class="absolute bottom-[10%] -right-[10%] w-[40%] h-[40%] rounded-full bg-orange-500/10 dark:bg-orange-600/10 blur-[120px] mix-blend-multiply dark:mix-blend-screen opacity-70" style="animation: pulse 12s cubic-bezier(0.4, 0, 0.6, 1) infinite;"></div>
        </div>
        <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
            <div class="text-center mb-20 gsap-fade-up">
                <span class="text-accent2 dark:text-zinc-400 font-bold tracking-[0.15em] uppercase text-xs mb-4 block">
                    <%= typeof t !== 'undefined' ? t('steps.tag') : 'Get Involved' %>
                </span>
                <h2 class="text-4xl md:text-5xl font-black tracking-tight text-studio-900 dark:text-white">
                    <%= typeof t !== 'undefined' ? t('steps.title') : 'Your Next Steps' %>
                </h2>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 gsap-stagger-container">
                <!-- Step 1 -->
                <div class="macos-card p-8 lg:p-10 group gsap-stagger-item dark:bg-studio-900/50 border border-zinc-100 dark:border-white/5 hover:border-blue-500/30 transition-all duration-300 shadow-sm hover:shadow-xl relative overflow-hidden">
                    <div class="w-14 h-14 bg-zinc-100 dark:bg-white/5 text-studio-900 dark:text-white rounded-2xl flex items-center justify-center mb-8 group-hover:bg-blue-600 group-hover:text-white transition-all duration-300 group-hover:-translate-y-1 shadow-sm">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                    </div>
                    <h3 class="text-2xl font-bold tracking-tight text-studio-900 dark:text-white mb-4 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                        <%= typeof t !== 'undefined' ? t('steps.step1.title') : '1. Attend a Gathering' %>
                    </h3>
                    <p class="text-zinc-600 dark:text-zinc-400 text-base mb-8 leading-relaxed">
                        <%= typeof t !== 'undefined' ? t('steps.step1.desc') : 'Join us every Tuesday at 7:00 PM for powerful worship and diving deep into the Word.' %>
                    </p>
                    <a href="#join" class="text-blue-600 dark:text-blue-400 text-sm font-bold hover:text-blue-700 dark:hover:text-blue-300 transition-colors inline-flex items-center gap-2 group-hover:gap-3 touch-manipulation">
                        <%= typeof t !== 'undefined' ? t('steps.step1.link') : 'Get Directions' %> <span>→</span>
                    </a>
                </div>
                <!-- Step 2 -->
                <div class="macos-card p-8 lg:p-10 group gsap-stagger-item dark:bg-studio-900/50 border border-zinc-100 dark:border-white/5 hover:border-purple-500/30 transition-all duration-300 shadow-sm hover:shadow-xl relative overflow-hidden">
                    <div class="w-14 h-14 bg-zinc-100 dark:bg-white/5 text-studio-900 dark:text-white rounded-2xl flex items-center justify-center mb-8 group-hover:bg-purple-600 group-hover:text-white transition-all duration-300 group-hover:-translate-y-1 shadow-sm">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    </div>
                    <h3 class="text-2xl font-bold tracking-tight text-studio-900 dark:text-white mb-4 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                        <%= typeof t !== 'undefined' ? t('steps.step2.title') : '2. Join a Small Group' %>
                    </h3>
                    <p class="text-zinc-600 dark:text-zinc-400 text-base mb-8 leading-relaxed">
                        <%= typeof t !== 'undefined' ? t('steps.step2.desc') : 'Authentic community where life happens. Find your circle and build deep, Christ-centered friendships.' %>
                    </p>
                    <a href="#join" class="text-purple-600 dark:text-purple-400 text-sm font-bold hover:text-purple-700 dark:hover:text-purple-300 transition-colors inline-flex items-center gap-2 group-hover:gap-3 touch-manipulation">
                        <%= typeof t !== 'undefined' ? t('steps.step2.link') : 'Find a Group' %> <span>→</span>
                    </a>
                </div>
                <!-- Step 3 -->
                <div class="macos-card p-8 lg:p-10 group gsap-stagger-item dark:bg-studio-900/50 border border-zinc-100 dark:border-white/5 hover:border-emerald-500/30 transition-all duration-300 shadow-sm hover:shadow-xl relative overflow-hidden">
                    <div class="w-14 h-14 bg-zinc-100 dark:bg-white/5 text-studio-900 dark:text-white rounded-2xl flex items-center justify-center mb-8 group-hover:bg-emerald-600 group-hover:text-white transition-all duration-300 group-hover:-translate-y-1 shadow-sm">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    </div>
                    <h3 class="text-2xl font-bold tracking-tight text-studio-900 dark:text-white mb-4 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                        <%= typeof t !== 'undefined' ? t('steps.step3.title') : '3. Discover Your Calling' %>
                    </h3>
                    <p class="text-zinc-600 dark:text-zinc-400 text-base mb-8 leading-relaxed">
