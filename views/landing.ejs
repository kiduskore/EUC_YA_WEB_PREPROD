<%- include('partials/header') %>
<!-- Hero Section -->
    <header class="relative min-h-screen flex items-end justify-start pt-20 pb-24 overflow-hidden">
        <!-- Hero Background Slideshow -->
        <div class="absolute inset-0">
            <div class="hero-slide" style="background-image: url('/static/hero_images/new_hero.jpg'); animation-delay: 0s;"></div>
            <div class="hero-slide" style="background-image: url('/static/hero_images/worship_crowd.jpg'); animation-delay: 5s;"></div>
            <div class="hero-slide" style="background-image: url('/static/hero_images/dark_worship.jpg'); animation-delay: 10s;"></div>
            <div class="hero-slide" style="background-image: url('/static/hero_images/crowd_praying.jpg'); animation-delay: 15s;"></div>
            <div class="hero-slide" style="background-image: url('/static/hero_images/guitarist.jpg'); animation-delay: 20s;"></div>
            <div class="hero-slide" style="background-image: url('/static/hero_images/man_praying.jpg'); animation-delay: 25s;"></div>
            <div class="hero-slide" style="background-image: url('/static/hero_images/singer.jpg'); animation-delay: 30s;"></div>
        </div>
        
        <!-- Premium Gradient Overlay (Darker at bottom for text contrast) -->
        <div class="absolute inset-0 bg-gradient-to-t from-studio-900 via-studio-900/60 to-transparent"></div>

        <style>
            .hero-slide {
                position: absolute;
                inset: 0;
                background-size: cover;
                background-position: center;
                opacity: 0;
                animation: heroFade 35s infinite;
            }
            @keyframes heroFade {
                0%   { opacity: 0; transform: scale(1); }
                3%   { opacity: 1; }
                14%  { opacity: 1; transform: scale(1.05); }
                17%  { opacity: 0; transform: scale(1.08); }
                100% { opacity: 0; transform: scale(1.1); }
            }
        </style>
        
        <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-12">
            <div class="max-w-4xl gsap-stagger-container">
                <!-- Unmissable Save The Date Anchor Pill for Knowing God Gathering -->
                <div class="mb-4 gsap-stagger-item">
                    <a href="#coming-soon-event" class="inline-flex items-center gap-2.5 px-4 sm:px-5 py-2 rounded-full bg-gradient-to-r from-indigo-950/90 via-purple-950/90 to-studio-950/90 hover:from-indigo-900 hover:to-purple-900 border border-indigo-400/50 backdrop-blur-xl shadow-2xl transition-all group cursor-pointer">
                        <span class="px-2.5 py-0.5 rounded-full bg-amber-400/25 text-amber-300 border border-amber-400/40 text-[10px] font-black uppercase tracking-wider flex items-center gap-1 shadow-sm">
                            <span>✨</span> Save The Date
                        </span>
                        <span class="text-white text-xs sm:text-sm font-bold">
                            Coming Soon: <span class="text-indigo-200 group-hover:text-amber-200 transition-colors">Knowing God</span>
                        </span>
                        <span class="text-indigo-300/80 text-xs hidden sm:inline font-serif italic">· Isaiah 40:28</span>
                        <span class="text-indigo-300 group-hover:translate-y-0.5 transition-transform text-xs font-bold">&darr;</span>
                    </a>
                </div>

                <div class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full border border-white/10 bg-white/5 backdrop-blur-md mb-6 gsap-stagger-item shadow-2xl">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-white text-xs tracking-[0.2em] font-bold uppercase"><%= typeof t !== 'undefined' ? t('hero.tag') : 'EUCMD Young Adults' %></span>
                </div>

                <h1 class="text-white text-2xl sm:text-3xl md:text-4xl lg:text-[2.65rem] font-black tracking-tight leading-[1.2] mb-5 gsap-stagger-item drop-shadow-2xl">
                    <%= typeof t !== 'undefined' ? t('hero.titleLine1') : '“Gathered in His Presence,' %><br/>
                    <span class="text-white/80">
                        <%= typeof t !== 'undefined' ? t('hero.titleLine2') : 'Empowered for His Purpose.”' %>
                    </span>
                </h1>

                <!-- Scripture Motto Reference -->
                <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white font-semibold text-xs sm:text-sm tracking-wide mb-8 gsap-stagger-item shadow-lg">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                    <span><%= typeof t !== 'undefined' ? t('hero.scripture') : 'Acts 1:14 · Acts 1:8' %></span>
                </div>

                <p class="text-zinc-200 text-lg md:text-2xl max-w-2xl font-medium leading-relaxed mb-12 gsap-stagger-item drop-shadow-lg">
                    <%= typeof t !== 'undefined' ? t('hero.subtitle') : 'We are a community of young adults in Maryland passionate about encountering Jesus, equipping believers, and empowering disciples.' %>
                </p>

                <div class="flex flex-col sm:flex-row gap-4 items-center gsap-stagger-item">
                    <a href="/join" class="w-full sm:w-auto px-10 py-4 min-h-[56px] flex items-center justify-center bg-white text-studio-900 font-bold rounded-full hover:bg-zinc-100 active:bg-zinc-200 transition-all text-center text-sm tracking-wide touch-manipulation active:scale-[0.98] shadow-xl">
                        <%= typeof t !== 'undefined' ? t('hero.joinGroup') : 'Join a Small Group' %>
                    </a>
                    <a href="#resources" class="w-full sm:w-auto px-10 py-4 min-h-[56px] flex items-center justify-center bg-transparent border-2 border-white/20 text-white hover:bg-white/10 active:bg-white/20 transition-all rounded-full text-center text-sm font-bold tracking-wide backdrop-blur-md touch-manipulation active:scale-[0.98]">
                        <%= typeof t !== 'undefined' ? t('hero.freeResources') : 'Explore Resources' %>
                    </a>
                </div>

                <!-- Quick Search Bar (Submits to /search and launches instant palette) -->
                <div class="mt-6 max-w-lg w-full gsap-stagger-item">
                    <form action="/search" method="GET" class="w-full relative">
                        <div class="flex items-center justify-between p-1.5 sm:p-2 rounded-2xl bg-white/10 hover:bg-white/15 focus-within:bg-white/20 border border-white/25 backdrop-blur-xl transition-all shadow-2xl">
                            <div class="flex items-center gap-3 pl-3 pr-2 flex-1 min-w-0">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                                <input type="text" 
                                       name="q" 
                                       placeholder="Search teachings, scriptures, events..." 
                                       class="w-full bg-transparent text-white placeholder-zinc-300 text-xs sm:text-sm font-medium focus:outline-none border-none py-1.5"
                                       autocomplete="off"
                                       onclick="openSiteSearchModal()">
                            </div>
                            <button type="submit" class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition-all shrink-0 cursor-pointer shadow-sm">
                                Search
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <!-- ============================================================ -->
    <!-- COMING SOON EVENT: KNOWING GOD (Isaiah 40:28)                 -->
    <!-- ============================================================ -->
    <section id="coming-soon-event" class="py-16 md:py-24 bg-studio-900 relative overflow-hidden border-b border-zinc-800">
        <!-- Ambient Background Glows -->
        <div class="absolute inset-0 pointer-events-none overflow-hidden">
            <div class="absolute -top-[15%] left-1/2 -translate-x-1/2 w-[700px] h-[500px] rounded-full bg-indigo-500/15 blur-[140px]"></div>
            <div class="absolute bottom-0 right-[10%] w-[450px] h-[450px] rounded-full bg-purple-500/15 blur-[120px]"></div>
            <div class="absolute top-[30%] -left-[10%] w-[400px] h-[400px] rounded-full bg-amber-400/10 blur-[130px]"></div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 relative z-10">
            <!-- Section Header Tag -->
            <div class="text-center mb-8 sm:mb-12 gsap-fade-up">
                <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-indigo-500/30 bg-indigo-950/60 backdrop-blur-md mb-4 shadow-lg shadow-indigo-950/50">
                    <span class="w-2.5 h-2.5 rounded-full bg-indigo-400 animate-ping"></span>
                    <span class="text-indigo-300 text-xs font-bold tracking-[0.2em] uppercase">Upcoming Special Event • Coming Soon</span>
                </div>
                <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight">
                    Get Ready for What God is Doing
                </h2>
                <p class="text-zinc-400 max-w-xl mx-auto text-sm sm:text-base mt-3">
                    A holy gathering for young adults across Maryland seeking spiritual renewal, deep worship, and an encounter with the living God.
                </p>
            </div>

            <!-- Main Feature Event Banner Card -->
            <div class="relative rounded-3xl overflow-hidden border border-indigo-500/30 shadow-[0_25px_60px_-15px_rgba(99,102,241,0.35)] bg-zinc-950 group">
                <!-- Panoramic Majestic Mountain & Cosmic Heavens Container -->
                <div class="relative min-h-[540px] sm:min-h-[600px] md:min-h-[660px] flex flex-col justify-between p-6 sm:p-10 md:p-14 overflow-hidden">
                    <!-- High-Resolution Starry Mountain Backdrop for "Knowing God" -->
                    <div class="absolute inset-0 bg-cover bg-center transition-transform duration-1000 ease-out group-hover:scale-105" 
                         style="background-image: url('/static/hero_images/knowing_god_stars.jpg');"></div>
                    
                    <!-- Multi-layered Atmospheric Gradient Overlays -->
                    <div class="absolute inset-0 bg-gradient-to-b from-indigo-950/60 via-transparent to-studio-950/95"></div>
                    <div class="absolute top-[20%] left-1/2 -translate-x-1/2 w-[650px] h-[380px] bg-gradient-to-r from-indigo-500/25 via-purple-400/30 to-amber-300/20 blur-3xl rounded-full pointer-events-none knowing-aura-glow"></div>
                    <div class="absolute inset-0 bg-studio-950/25"></div>

                    <!-- Top Card Bar: Event Status & Scripture Badge -->
                    <div class="relative z-10 flex flex-wrap items-center justify-between gap-4">
                        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-studio-950/80 backdrop-blur-md border border-white/15 text-white text-xs font-semibold shadow-md">
                            <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
                            <span>EUCMD Young Adults Gathering</span>
                        </div>
                        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-950/85 backdrop-blur-md border border-indigo-400/30 text-indigo-200 text-xs font-bold tracking-wider uppercase shadow-md">
                            <span>✨ Save The Date</span>
                        </div>
                    </div>

                    <style>
                        @keyframes knowingGlowBreath {
                            0%, 100% {
                                filter: drop-shadow(0 0 16px rgba(129, 140, 248, 0.8))
                                        drop-shadow(0 0 42px rgba(168, 85, 247, 0.6))
                                        drop-shadow(0 8px 30px rgba(0, 0, 0, 0.95));
                                transform: rotate(-1deg) scale(1);
                            }
                            50% {
                                filter: drop-shadow(0 0 30px rgba(129, 140, 248, 1))
                                        drop-shadow(0 0 70px rgba(192, 132, 252, 0.85))
                                        drop-shadow(0 0 110px rgba(251, 191, 36, 0.5))
                                        drop-shadow(0 10px 35px rgba(0, 0, 0, 0.95));
                                transform: rotate(-1deg) scale(1.025);
                            }
                        }

                        @keyframes knowingShimmer {
                            0% { background-position: 0% 50%; }
                            50% { background-position: 100% 50%; }
                            100% { background-position: 0% 50%; }
                        }

                        @keyframes knowingAuraPulse {
                            0%, 100% {
                                opacity: 0.55;
                                transform: scale(0.95);
                            }
                            50% {
                                opacity: 0.95;
                                transform: scale(1.08);
                            }
                        }

                        @keyframes knowingSparkDrift {
                            0% {
                                transform: translateY(15px) scale(0.6);
                                opacity: 0;
                            }
                            30% {
                                opacity: 0.85;
                            }
                            80% {
                                opacity: 0.7;
                            }
                            100% {
                                transform: translateY(-70px) scale(1.15);
                                opacity: 0;
                            }
                        }

                        .knowing-title-animated {
                            font-family: 'Kaushan Script', cursive;
                            background: linear-gradient(135deg, #ffffff 0%, #ede9fe 25%, #c4b5fd 45%, #a78bfa 65%, #818cf8 85%, #fde68a 100%);
                            background-size: 250% 250%;
                            -webkit-background-clip: text;
                            -webkit-text-fill-color: transparent;
                            animation: knowingGlowBreath 3.6s ease-in-out infinite, knowingShimmer 7s ease infinite;
                            display: inline-block;
                        }

                        .knowing-god-text {
                            background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 30%, #c4b5fd 70%, #818cf8 100%);
                            -webkit-background-clip: text;
                            -webkit-text-fill-color: transparent;
                            filter: drop-shadow(0 0 18px rgba(129, 140, 248, 0.85)) drop-shadow(0 4px 20px rgba(0, 0, 0, 0.95));
                        }

                        .knowing-aura-glow {
                            animation: knowingAuraPulse 4.5s ease-in-out infinite;
                        }

                        .knowing-spark {
                            position: absolute;
                            border-radius: 9999px;
                            pointer-events: none;
                            animation: knowingSparkDrift 4s ease-in-out infinite;
                        }
                    </style>

                    <!-- Center Artwork: Radiant, Majestic Knowing God Typography -->
                    <div class="relative z-10 my-auto py-8 sm:py-14 text-center max-w-3xl mx-auto flex flex-col items-center">
                        <!-- Living Celestial Sunburst Aura Behind Typography -->
                        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[340px] sm:w-[540px] md:w-[680px] h-[220px] sm:h-[320px] bg-gradient-to-r from-indigo-500/25 via-purple-400/30 to-amber-300/20 blur-3xl rounded-full pointer-events-none knowing-aura-glow -z-10"></div>
                        
                        <!-- Floating Starlight Sparks (Holy Light & Wonder) -->
                        <div class="absolute inset-0 pointer-events-none overflow-hidden -z-5">
                            <span class="knowing-spark w-2 h-2 bg-amber-300 shadow-[0_0_10px_#f59e0b] top-[40%] left-[20%]" style="animation-delay: 0s;"></span>
                            <span class="knowing-spark w-2.5 h-2.5 bg-indigo-300 shadow-[0_0_12px_#818cf8] top-[50%] right-[22%]" style="animation-delay: 1.2s;"></span>
                            <span class="knowing-spark w-1.5 h-1.5 bg-purple-200 shadow-[0_0_8px_#c084fc] top-[30%] right-[32%]" style="animation-delay: 2.3s;"></span>
                            <span class="knowing-spark w-2 h-2 bg-amber-200 shadow-[0_0_10px_#fbbf24] top-[60%] left-[35%]" style="animation-delay: 3.1s;"></span>
                        </div>

                        <!-- Sacred Scripture Reference Badge -->
                        <div class="inline-flex items-center gap-2 mb-2 sm:mb-3 px-4 py-1.5 rounded-full bg-amber-400/10 border border-amber-300/30 backdrop-blur-md shadow-[0_0_20px_rgba(245,158,11,0.25)] select-none">
                            <span class="text-amber-300 text-xs sm:text-sm animate-pulse">✦</span>
                            <span class="font-serif italic text-amber-200 text-base sm:text-xl md:text-2xl font-bold tracking-widest drop-shadow-[0_2px_8px_rgba(0,0,0,0.95)]">
                                ISAIAH 40:28
                            </span>
                            <span class="text-amber-300 text-xs sm:text-sm animate-pulse">✦</span>
                        </div>

                        <!-- "Knowing" Calligraphic Animated Luminous Script -->
                        <div class="relative py-1">
                            <h1 class="knowing-title-animated text-7xl sm:text-8xl md:text-9xl lg:text-[10.5rem] font-bold leading-[0.9] select-none tracking-normal">
                                Knowing
                            </h1>
                        </div>

                        <!-- "GOD" Bold Herald Proclamation with Radiant Rays -->
                        <div class="flex items-center justify-center gap-3 sm:gap-6 mt-1 sm:mt-2 select-none w-full">
                            <span class="h-[2px] w-8 sm:w-16 md:w-28 bg-gradient-to-r from-transparent via-indigo-400/80 to-amber-300"></span>
                            <h2 class="knowing-god-text text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-black uppercase tracking-[0.25em] sm:tracking-[0.35em] select-none m-0">
                                GOD
                            </h2>
                            <span class="h-[2px] w-8 sm:w-16 md:w-28 bg-gradient-to-l from-transparent via-indigo-400/80 to-amber-300"></span>
                        </div>

                        <!-- "Coming Soon" Serif Italic Radiant Subtitle -->
                        <div class="relative mt-4 sm:mt-6 select-none">
                            <div class="font-serif italic text-2xl sm:text-3xl md:text-4xl text-transparent bg-clip-text bg-gradient-to-r from-amber-100 via-amber-200 to-amber-400 font-semibold tracking-wide drop-shadow-[0_3px_12px_rgba(245,158,11,0.45)]">
                                Coming Soon
                            </div>
                            <div class="h-0.5 w-24 sm:w-36 mx-auto mt-2 bg-gradient-to-r from-transparent via-amber-300/60 to-transparent"></div>
                        </div>

                        <!-- Scripture Full Quote Glass Box -->
                        <div class="mt-6 sm:mt-8 max-w-xl px-6 py-4 rounded-2xl bg-studio-950/85 backdrop-blur-md border border-indigo-500/30 shadow-[0_12px_40px_rgba(0,0,0,0.85),0_0_25px_rgba(99,102,241,0.2)]">
                            <p class="text-zinc-100 text-xs sm:text-sm md:text-base font-medium italic leading-relaxed">
                                "Do you not know? Have you not heard? The Lord is the everlasting God, the Creator of the ends of the earth. He will not grow tired or weary, and His understanding no one can fathom."
                            </p>
                            <span class="block text-right text-indigo-300 font-bold text-xs mt-1.5 tracking-wide">— Isaiah 40:28</span>
                        </div>
                    </div>
                </div>

                <!-- Bottom Bar: Quick Details -->
                <div class="relative z-10 flex items-center justify-center p-6 sm:p-7 border-t border-white/10 bg-studio-950/80 backdrop-blur-md">
                    <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-8 text-xs sm:text-sm text-zinc-300">
                        <div class="flex items-center gap-2">
                            <span class="p-1.5 rounded-lg bg-indigo-500/20 text-indigo-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            </span>
                            <span>Maryland &amp; DMV Young Adults</span>
                        </div>
                        <span class="hidden sm:inline text-zinc-600">•</span>
                        <div class="flex items-center gap-2">
                            <span class="p-1.5 rounded-lg bg-amber-500/20 text-amber-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            </span>
                            <span>Dates &amp; Venue Announcing Soon</span>
                        </div>
                        <span class="hidden sm:inline text-zinc-600">•</span>
                        <div class="flex items-center gap-2">
                            <span class="p-1.5 rounded-lg bg-purple-500/20 text-purple-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                            </span>
                            <span>Intimacy, Worship &amp; Encounter</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bento Highlights: What to Expect -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-8 gsap-stagger-container">
                <div class="p-5 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm gsap-stagger-item hover:border-indigo-500/30 transition-all">
                    <div class="text-2xl mb-2">🌌</div>
                    <h3 class="text-white font-bold text-sm mb-1">Divine Encounter</h3>
                    <p class="text-zinc-400 text-xs leading-relaxed">Stepping away from the everyday noise into the stillness of God's presence, seeking Him with our whole hearts.</p>
                </div>
                <div class="p-5 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm gsap-stagger-item hover:border-indigo-500/30 transition-all">
                    <div class="text-2xl mb-2">🔥</div>
                    <h3 class="text-white font-bold text-sm mb-1">Fervent Prayer</h3>
                    <p class="text-zinc-400 text-xs leading-relaxed">Standing on Isaiah 40:28 to encounter the everlasting God, the Creator of the ends of the earth whose understanding no one can fathom.</p>
                </div>
                <div class="p-5 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm gsap-stagger-item hover:border-indigo-500/30 transition-all">
                    <div class="text-2xl mb-2">🎶</div>
                    <h3 class="text-white font-bold text-sm mb-1">Intimate Worship</h3>
                    <p class="text-zinc-400 text-xs leading-relaxed">Extended, unhurried atmospheres where we gaze upon the beauty of the Lord and minister directly to Jesus.</p>
                </div>
                <div class="p-5 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm gsap-stagger-item hover:border-indigo-500/30 transition-all">
                    <div class="text-2xl mb-2">🤝</div>
                    <h3 class="text-white font-bold text-sm mb-1">Kingdom Community</h3>
                    <p class="text-zinc-400 text-xs leading-relaxed">Building authentic, lifelong friendships with brothers and sisters committed to knowing God and making Him known.</p>
                </div>
            </div>
        </div>

        <!-- VIP Notification Modal -->
        <div id="revive-modal" class="fixed inset-0 z-[120] bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 transition-all duration-300 opacity-0 pointer-events-none" style="display: none;">
            <div class="bg-studio-900 border border-teal-500/30 rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl relative transform transition-transform duration-300 scale-95" id="revive-modal-box">
                <button onclick="closeReviveNotifyModal()" class="absolute top-4 right-4 text-zinc-400 hover:text-white p-2 rounded-full hover:bg-white/10 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>

                <div class="text-center mb-6">
                    <div class="w-12 h-12 rounded-2xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center mx-auto mb-3">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                    </div>
                    <span class="text-indigo-400 font-bold text-xs uppercase tracking-widest block mb-1">Knowing God (Isaiah 40:28)</span>
                    <h3 class="text-2xl font-black text-white">Get Priority Notification</h3>
