        </div>

        <!-- Navigation CTAs -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="/" class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-bold text-sm shadow-md transition-all">
                &larr; Return to Homepage
            </a>
            <a href="/events" class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-zinc-100 dark:bg-studio-800 hover:bg-zinc-200 dark:hover:bg-studio-700 active:scale-95 text-zinc-900 dark:text-white font-bold text-sm transition-all border border-zinc-200 dark:border-white/10">
                Upcoming Events & RSVP
            </a>
            <a href="/#resources" class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-zinc-100 dark:bg-studio-800 hover:bg-zinc-200 dark:hover:bg-studio-700 active:scale-95 text-zinc-900 dark:text-white font-bold text-sm transition-all border border-zinc-200 dark:border-white/10">
                Discipleship Resources
            </a>
